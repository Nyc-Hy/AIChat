<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AIChat.App.Avalonia.App"
             xmlns:local="using:AIChat.App.Avalonia"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Inter, Segoe UI, Arial" />
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#697386" />
        </Style>
        <Style Selector="TextBlock.page-title">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#111827" />
        </Style>
        <Style Selector="TextBlock.body">
            <Setter Property="Foreground" Value="#303947" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#7A8493" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="Border.surface">
            <Setter Property="Background" Value="#F5F7FA" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="Border.rail">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style Selector="Border.input-shell">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="Button.list-action">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.list-action:pointerover">
            <Setter Property="Background" Value="#F8FAFC" />
        </Style>
        <Style Selector="Border.section-divider">
            <Setter Property="Background" Value="#E2E8F0" />
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,16" />
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="Background" Value="#EAF2FF" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="9,4" />
        </Style>
        <Style Selector="Border.badge.success">
            <Setter Property="Background" Value="#E7F7EF" />
        </Style>
        <Style Selector="Border.badge.warning">
            <Setter Property="Background" Value="#FFF3D6" />
        </Style>
        <Style Selector="ListBox.clean">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBox.clean ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.clean ListBoxItem:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.clean ListBoxItem:selected">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.chrome-button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="Button.chrome-button:pointerover">
            <Setter Property="Background" Value="#E6EBF2" />
            <Setter Property="Foreground" Value="#1F2937" />
        </Style>
        <Style Selector="Button.chrome-button.close:pointerover">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
    </Application.Styles>
</Application>
