<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AIChat.App.Avalonia.App"
             xmlns:local="using:AIChat.App.Avalonia"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <!--
      Token dictionary — every color / spacing / radius / font value in
      the styles below references a key defined here. To re-skin the
      whole app, edit Resources/Tokens.axaml (or swap in
      Resources/Tokens.Dark.axaml under RequestedThemeVariant="Dark").
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://AIChat.App.Avalonia/Resources/Tokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceInclude x:Key="Dark" Source="avares://AIChat.App.Avalonia/Resources/Tokens.Dark.axaml" />
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
        </Style>

        <!-- ===== Text ===== -->
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="{StaticResource FontSm}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="TextBlock.page-title">
            <Setter Property="FontSize" Value="{StaticResource FontXl}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style Selector="TextBlock.body">
            <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
            <Setter Property="FontSize" Value="{StaticResource FontBase}" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSm}" />
        </Style>

        <!-- ===== Surfaces (Border) ===== -->
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
            <Setter Property="Padding" Value="{StaticResource Space4}" />
        </Style>
        <Style Selector="Border.surface">
            <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
            <Setter Property="Padding" Value="{StaticResource Space3}" />
        </Style>
        <Style Selector="Border.rail">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style Selector="Border.input-shell">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
            <Setter Property="Padding" Value="{StaticResource Space3}" />
        </Style>
        <Style Selector="Border.section-divider">
            <Setter Property="Background" Value="{StaticResource DividerBrush}" />
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,16" />
        </Style>

        <!-- ===== Badges ===== -->
        <Style Selector="Border.badge">
            <Setter Property="Background" Value="{StaticResource InfoBgBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusFull}" />
            <Setter Property="Padding" Value="9,4" />
        </Style>
        <Style Selector="Border.badge.success">
            <Setter Property="Background" Value="{StaticResource SuccessBgBrush}" />
        </Style>
        <Style Selector="Border.badge.warning">
            <Setter Property="Background" Value="{StaticResource WarningBgBrush}" />
        </Style>

        <!-- ===== List ===== -->
        <Style Selector="ListBox.clean">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBox.clean ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.clean ListBoxItem:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.clean ListBoxItem:selected">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- ===== Buttons ===== -->
        <Style Selector="Button.list-action">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
            <Setter Property="Padding" Value="{StaticResource Space3}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.list-action:pointerover">
            <Setter Property="Background" Value="{StaticResource HoverBgBrush}" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource AccentBlueBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.chrome-button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="Button.chrome-button:pointerover">
            <Setter Property="Background" Value="{StaticResource HoverBg2Brush}" />
            <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
        </Style>
        <Style Selector="Button.chrome-button.close:pointerover">
            <Setter Property="Background" Value="{StaticResource CloseHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}" />
        </Style>

        <!-- ===== Inputs ===== -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{StaticResource HoverBgBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
    </Application.Styles>
</Application>
