<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">

  <!--
    AIChat design tokens — 1.0 design system.
    Every color / spacing / radius / font / motion value lives here.
    XAML references via {StaticResource KeyName} only; no inline literals.

    Sections:
      1. Surface ladder  (Bg → SurfaceSunken → Surface → SurfaceRaised → SurfaceOverlay)
      2. Line ladder     (Line → LineSoft → LineStrong)
      3. Text ladder     (Text → Text2 → Muted)
      4. Accent ramp     (teal 50→900, plus semantic hover/active/fg)
      5. Status          (Info / Success / Warning / Error — bg + fg + border)
      6. Special         (CodeBg / CodeFg / HeroGradient / Scrim / FocusRing)
      7. Brushes         (every color above, exposed as a brush)
      8. Type ramp       (Display / H1 / H2 / H3 / BodyL/M/S / Caption / Overline / Micro)
      9. Line height + tracking
     10. Spacing         (0..11 + Padding 1..7)
     11. Radius          (Xs / Sm / Md / Lg / Xl / 2xl / Pill / Full)
     12. Elevation       (0..5 + Toast)
     13. Motion          (TimeSpans for Fast / Base / Slow / Bubble / Dot / Toast)
  -->

  <!-- ============================================================ 1. Surface ladder -->
  <Color x:Key="BgColor">#fafaf7</Color>
  <Color x:Key="SurfaceSunkenColor">#f1ede4</Color>
  <Color x:Key="SurfaceColor">#ffffff</Color>
  <Color x:Key="SurfaceRaisedColor">#ffffff</Color>
  <Color x:Key="SurfaceOverlayColor">#ffffff</Color>

  <!-- ============================================================ 2. Line ladder -->
  <Color x:Key="LineColor">#e9e3d6</Color>
  <Color x:Key="LineSoftColor">#ebe5d3</Color>
  <Color x:Key="LineStrongColor">#d8d2c2</Color>

  <!-- ============================================================ 3. Text ladder -->
  <Color x:Key="TextColor">#18181b</Color>
  <Color x:Key="Text2Color">#3a4256</Color>
  <Color x:Key="MutedColor">#6b6b75</Color>

  <!-- ============================================================ 4. Accent ramp (teal) -->
  <Color x:Key="Accent50Color">#ecf5f2</Color>
  <Color x:Key="Accent100Color">#cfe5dd</Color>
  <Color x:Key="Accent200Color">#a4cdc0</Color>
  <Color x:Key="Accent300Color">#73b39f</Color>
  <Color x:Key="Accent400Color">#4d9482</Color>
  <Color x:Key="AccentColor">#2f6f5e</Color>
  <Color x:Key="Accent600Color">#255e4f</Color>
  <Color x:Key="Accent700Color">#1d4a3e</Color>
  <Color x:Key="Accent800Color">#163a31</Color>
  <Color x:Key="Accent900Color">#0e2620</Color>
  <Color x:Key="AccentSoftColor">#1F2f6f5e</Color>
  <Color x:Key="AccentHoverColor">#255e4f</Color>
  <Color x:Key="AccentActiveColor">#1d4a3e</Color>
  <Color x:Key="AccentFgColor">#ffffff</Color>

  <!-- ============================================================ 5. Status -->
  <!-- Info (cool blue) -->
  <Color x:Key="InfoBgColor">#eaf2ff</Color>
  <Color x:Key="InfoFgColor">#1e3a8a</Color>
  <Color x:Key="InfoBorderColor">#c7d7fe</Color>
  <!-- Success (green) -->
  <Color x:Key="SuccessBgColor">#e7f7ef</Color>
  <Color x:Key="SuccessFgColor">#0e3b21</Color>
  <Color x:Key="SuccessBorderColor">#bfe5cc</Color>
  <!-- Warning (amber) -->
  <Color x:Key="WarningBgColor">#fff3d6</Color>
  <Color x:Key="WarningFgColor">#7c2d12</Color>
  <Color x:Key="WarningBorderColor">#f4cf86</Color>
  <!-- Error / Danger -->
  <Color x:Key="ErrorBgColor">#fbeaeb</Color>
  <Color x:Key="ErrorFgColor">#8a1f23</Color>
  <Color x:Key="ErrorBorderColor">#e9b4b6</Color>

  <!-- ============================================================ 6. Special -->
  <Color x:Key="CodeBgColor">#f5f0e1</Color>
  <Color x:Key="CodeFgColor">#2a3a36</Color>
  <Color x:Key="HeroGradientStartColor">#fafaf7</Color>
  <Color x:Key="HeroGradientEndColor">#e8e9d8</Color>
  <Color x:Key="ScrimColor">#80000000</Color>
  <Color x:Key="FocusRingColor">#2f6f5e</Color>
  <!-- 1.0.1: drag-and-drop overlay wash. Teal-200 at 20% alpha so the
       cream page background still bleeds through. -->
  <Color x:Key="OverlayWashColor">#33e8c4</Color>

  <!-- ============================================================ 7. Brushes -->
  <SolidColorBrush x:Key="BgBrush"                Color="{DynamicResource BgColor}" />
  <SolidColorBrush x:Key="SurfaceSunkenBrush"     Color="{DynamicResource SurfaceSunkenColor}" />
  <SolidColorBrush x:Key="SurfaceBrush"           Color="{DynamicResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush"     Color="{DynamicResource SurfaceRaisedColor}" />
  <SolidColorBrush x:Key="SurfaceOverlayBrush"    Color="{DynamicResource SurfaceOverlayColor}" />
  <!-- 1.0.1: translucent accent wash for the drag-and-drop overlay.
       Routed through a DynamicResource so the dark theme can swap
       the alpha (the lighter teal washes out against the near-black
       dark surface). -->
  <SolidColorBrush x:Key="OverlayWashBrush"       Color="{DynamicResource OverlayWashColor}" />

  <SolidColorBrush x:Key="LineBrush"              Color="{DynamicResource LineColor}" />
  <SolidColorBrush x:Key="LineSoftBrush"          Color="{DynamicResource LineSoftColor}" />
  <SolidColorBrush x:Key="LineStrongBrush"        Color="{DynamicResource LineStrongColor}" />

  <SolidColorBrush x:Key="TextBrush"              Color="{DynamicResource TextColor}" />
  <SolidColorBrush x:Key="Text2Brush"             Color="{DynamicResource Text2Color}" />
  <SolidColorBrush x:Key="MutedBrush"             Color="{DynamicResource MutedColor}" />

  <SolidColorBrush x:Key="AccentBrush"            Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="Accent50Brush"          Color="{DynamicResource Accent50Color}" />
  <SolidColorBrush x:Key="Accent100Brush"         Color="{DynamicResource Accent100Color}" />
  <SolidColorBrush x:Key="Accent200Brush"         Color="{DynamicResource Accent200Color}" />
  <SolidColorBrush x:Key="Accent300Brush"         Color="{DynamicResource Accent300Color}" />
  <SolidColorBrush x:Key="Accent400Brush"         Color="{DynamicResource Accent400Color}" />
  <SolidColorBrush x:Key="Accent500Brush"         Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="Accent600Brush"         Color="{DynamicResource Accent600Color}" />
  <SolidColorBrush x:Key="Accent700Brush"         Color="{DynamicResource Accent700Color}" />
  <SolidColorBrush x:Key="Accent800Brush"         Color="{DynamicResource Accent800Color}" />
  <SolidColorBrush x:Key="Accent900Brush"         Color="{DynamicResource Accent900Color}" />
  <SolidColorBrush x:Key="AccentSoftBrush"        Color="{DynamicResource AccentSoftColor}" />
  <SolidColorBrush x:Key="AccentHoverBrush"       Color="{DynamicResource AccentHoverColor}" />
  <SolidColorBrush x:Key="AccentActiveBrush"      Color="{DynamicResource AccentActiveColor}" />
  <SolidColorBrush x:Key="AccentFgBrush"          Color="{DynamicResource AccentFgColor}" />

  <SolidColorBrush x:Key="InfoBgBrush"            Color="{DynamicResource InfoBgColor}" />
  <SolidColorBrush x:Key="InfoFgBrush"            Color="{DynamicResource InfoFgColor}" />
  <SolidColorBrush x:Key="InfoBorderBrush"        Color="{DynamicResource InfoBorderColor}" />
  <SolidColorBrush x:Key="SuccessBgBrush"         Color="{DynamicResource SuccessBgColor}" />
  <SolidColorBrush x:Key="SuccessFgBrush"         Color="{DynamicResource SuccessFgColor}" />
  <SolidColorBrush x:Key="SuccessBorderBrush"     Color="{DynamicResource SuccessBorderColor}" />
  <SolidColorBrush x:Key="WarningBgBrush"         Color="{DynamicResource WarningBgColor}" />
  <SolidColorBrush x:Key="WarningFgBrush"         Color="{DynamicResource WarningFgColor}" />
  <SolidColorBrush x:Key="WarningBorderBrush"     Color="{DynamicResource WarningBorderColor}" />
  <SolidColorBrush x:Key="ErrorBgBrush"           Color="{DynamicResource ErrorBgColor}" />
  <SolidColorBrush x:Key="ErrorFgBrush"           Color="{DynamicResource ErrorFgColor}" />
  <SolidColorBrush x:Key="ErrorBorderBrush"       Color="{DynamicResource ErrorBorderColor}" />

  <SolidColorBrush x:Key="CodeBgBrush"            Color="{DynamicResource CodeBgColor}" />
  <SolidColorBrush x:Key="CodeFgBrush"            Color="{DynamicResource CodeFgColor}" />
  <SolidColorBrush x:Key="HeroGradientStartBrush" Color="{DynamicResource HeroGradientStartColor}" />
  <SolidColorBrush x:Key="HeroGradientEndBrush"   Color="{DynamicResource HeroGradientEndColor}" />
  <SolidColorBrush x:Key="ScrimBrush"             Color="{DynamicResource ScrimColor}" />
  <SolidColorBrush x:Key="FocusRingBrush"         Color="{DynamicResource FocusRingColor}" />

  <!-- Badge foregrounds: for text inside the colored badge backgrounds. -->
  <SolidColorBrush x:Key="BadgeFgBrush"           Color="{DynamicResource TextColor}" />
  <SolidColorBrush x:Key="InfoBadgeFgBrush"       Color="{DynamicResource InfoFgColor}" />
  <SolidColorBrush x:Key="SuccessBadgeFgBrush"    Color="{DynamicResource SuccessFgColor}" />
  <SolidColorBrush x:Key="WarningBadgeFgBrush"    Color="{DynamicResource WarningFgColor}" />
  <SolidColorBrush x:Key="AccentVariantFgBrush"   Color="{DynamicResource AccentColor}" />

  <!-- Backward-compatible aliases for the few pre-ramp keys that XAML still references. -->
  <SolidColorBrush x:Key="AccentBlueBrush"        Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="HoverBgBrush"           Color="{DynamicResource SurfaceSunkenColor}" />
  <SolidColorBrush x:Key="HoverBg2Brush"          Color="{DynamicResource LineColor}" />
  <SolidColorBrush x:Key="DividerBrush"           Color="{DynamicResource LineColor}" />
  <SolidColorBrush x:Key="CloseHoverBrush"        Color="{DynamicResource ErrorFgColor}" />
  <SolidColorBrush x:Key="TextOnAccentBrush"      Color="{DynamicResource AccentFgColor}" />

  <!-- ============================================================ 8. Type ramp -->
  <x:Double x:Key="FontDisplay">40</x:Double>
  <x:Double x:Key="FontH1">30</x:Double>
  <x:Double x:Key="FontH2">22</x:Double>
  <x:Double x:Key="FontH3">18</x:Double>
  <x:Double x:Key="FontBodyL">16</x:Double>
  <x:Double x:Key="FontBodyM">14</x:Double>
  <x:Double x:Key="FontBodyS">13</x:Double>
  <x:Double x:Key="FontCaption">12</x:Double>
  <x:Double x:Key="FontOverline">11</x:Double>
  <x:Double x:Key="FontMicro">10</x:Double>

  <!-- ============================================================ 9. Line height + tracking -->
  <x:Double x:Key="LineHeightTight">34</x:Double>
  <x:Double x:Key="LineHeightSnug">22</x:Double>
  <x:Double x:Key="LineHeightNormal">21</x:Double>
  <x:Double x:Key="LineHeightRelaxed">24</x:Double>
  <x:Double x:Key="TrackingTight">-0.4</x:Double>
  <x:Double x:Key="TrackingDisplay">-1.2</x:Double>
  <x:Double x:Key="TrackingNormal">0</x:Double>
  <x:Double x:Key="TrackingWide">0.66</x:Double>

  <!-- ============================================================ 10. Spacing -->
  <x:Double x:Key="Space0">0</x:Double>
  <x:Double x:Key="Space1">4</x:Double>
  <x:Double x:Key="Space2">8</x:Double>
  <x:Double x:Key="Space3">12</x:Double>
  <x:Double x:Key="Space4">16</x:Double>
  <x:Double x:Key="Space5">20</x:Double>
  <x:Double x:Key="Space6">24</x:Double>
  <x:Double x:Key="Space7">32</x:Double>
  <x:Double x:Key="Space8">40</x:Double>
  <x:Double x:Key="Space9">48</x:Double>
  <x:Double x:Key="Space10">64</x:Double>
  <x:Double x:Key="Space11">80</x:Double>

  <Thickness x:Key="Padding1">4</Thickness>
  <Thickness x:Key="Padding2">8</Thickness>
  <Thickness x:Key="Padding3">12</Thickness>
  <Thickness x:Key="Padding4">16</Thickness>
  <Thickness x:Key="Padding5">20</Thickness>
  <Thickness x:Key="Padding6">24</Thickness>
  <Thickness x:Key="Padding7">32</Thickness>

  <!-- Backward-compatible aliases for the old Space1..6 / SpaceGap1..6. -->
  <Thickness x:Key="Space1T">4</Thickness>
  <Thickness x:Key="Space2T">8</Thickness>
  <Thickness x:Key="Space3T">12</Thickness>
  <Thickness x:Key="Space4T">16</Thickness>
  <Thickness x:Key="Space5T">20</Thickness>
  <Thickness x:Key="Space6T">24</Thickness>

  <!-- ============================================================ 11. Radius -->
  <CornerRadius x:Key="RadiusXs">4</CornerRadius>
  <CornerRadius x:Key="RadiusSm">6</CornerRadius>
  <CornerRadius x:Key="RadiusMd">10</CornerRadius>
  <CornerRadius x:Key="RadiusLg">14</CornerRadius>
  <CornerRadius x:Key="RadiusXl">20</CornerRadius>
  <CornerRadius x:Key="Radius2xl">28</CornerRadius>
  <CornerRadius x:Key="RadiusPill">999</CornerRadius>
  <CornerRadius x:Key="RadiusFull">999</CornerRadius>

  <!-- ============================================================ 12. Elevation -->
  <BoxShadows x:Key="Elevation0Shadow">0 0 0 0 #00000000</BoxShadows>
  <BoxShadows x:Key="Elevation1Shadow">0 1 2 0 #10000000, 0 0 0 1 #08000000</BoxShadows>
  <BoxShadows x:Key="Elevation2Shadow">0 4 12 0 #14000000, 0 0 0 1 #08000000</BoxShadows>
  <BoxShadows x:Key="Elevation3Shadow">0 8 24 0 #18000000, 0 0 0 1 #0A000000</BoxShadows>
  <BoxShadows x:Key="Elevation4Shadow">0 16 40 0 #24000000, 0 0 0 1 #0A000000</BoxShadows>
  <BoxShadows x:Key="Elevation5Shadow">0 24 64 0 #3C000000, 0 0 0 1 #10000000</BoxShadows>
  <BoxShadows x:Key="ElevationToastShadow">0 4 12 0 #18000000, 0 0 0 1 #10000000</BoxShadows>

  <!-- Backward-compatible aliases -->
  <BoxShadows x:Key="ModalShadow">0 16 40 0 #24000000, 0 0 0 1 #0A000000</BoxShadows>
  <BoxShadows x:Key="ToastShadow">0 4 12 0 #18000000, 0 0 0 1 #10000000</BoxShadows>
  <BoxShadows x:Key="FloatingShadow">0 8 24 0 #18000000, 0 0 0 1 #0A000000</BoxShadows>

  <!-- ============================================================ 13. Motion -->
  <sys:TimeSpan x:Key="MotionFast">0:0:0.100</sys:TimeSpan>
  <sys:TimeSpan x:Key="MotionBase">0:0:0.180</sys:TimeSpan>
  <sys:TimeSpan x:Key="MotionSlow">0:0:0.240</sys:TimeSpan>
  <sys:TimeSpan x:Key="MotionBubble">0:0:0.220</sys:TimeSpan>
  <sys:TimeSpan x:Key="MotionDot">0:0:1.200</sys:TimeSpan>
  <sys:TimeSpan x:Key="MotionToast">0:0:0.220</sys:TimeSpan>

  <!-- ============================================================ Font families -->
  <FontFamily x:Key="FontSans">Outfit, -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif</FontFamily>
  <FontFamily x:Key="FontMono">JetBrains Mono, ui-monospace, "Sarasa Mono SC", monospace</FontFamily>

</ResourceDictionary>
