<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AIChat.App.Avalonia.ViewModels"
             x:Class="AIChat.App.Avalonia.Views.Controls.ScheduledView"
             x:DataType="vm:MainWindowViewModel">

  <!--
    Wave 9 (parity plan §7 Wave 9): Scheduled modal. Mirrors
    the layout shape of MemoryEditorView / PluginsView —
    full-window scrim with a centered card. The card lists
    every scheduled task the registry has loaded plus a
    per-row action strip (暂停 / 恢复 / 记录运行 / 删除).

    Edit / create form is a follow-up slice. The first
    pass is intentionally list + run-now + pause/resume so
    the user can verify the registry contract end-to-end.

    We set x:DataType to MainWindowViewModel and route the
    inner bindings through `Scheduled.*` so the existing
    `IsScheduledOpen` bool on the host continues to drive
    IsVisible without needing a DataContext swap.
  -->
  <Grid Background="#80000000"
        IsVisible="{Binding IsScheduledOpen}">
    <Border Classes="modal-card"
            Width="720" MaxHeight="640"
            VerticalAlignment="Center" HorizontalAlignment="Center"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource LineSoftBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="20">
      <DockPanel DataContext="{Binding Scheduled}">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
          <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock Text="已安排" Classes="section-title" FontSize="16"/>
            <TextBlock Classes="muted" FontSize="11"
                       Text="Wave 9 first slice — 真实调度引擎接入见 follow-up"
                       FontFamily="{StaticResource FontMono}"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <Button Classes="chrome-button"
                    Command="{Binding ReloadCommand}"
                    ToolTip.Tip="重新加载">
              <Path Data="M5 12 a7 7 0 1 0 1.5 -4.2 M5 4 V8 H9"
                    Stroke="{Binding $parent[Button].Foreground}"
                    StrokeThickness="1.6" StrokeLineCap="Round"
                    Width="14" Height="14" Stretch="Uniform"/>
            </Button>
            <Button Classes="chrome-button"
                    Command="{Binding AddCommand}"
                    ToolTip.Tip="添加新任务">
              <TextBlock Text="+" FontSize="16" FontWeight="SemiBold" FontFamily="{StaticResource FontMono}"/>
            </Button>
          </StackPanel>
        </Grid>

        <Border Classes="error-banner"
                Background="{DynamicResource ErrorBgBrush}"
                BorderBrush="{DynamicResource ErrorBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8,6"
                Margin="0,0,0,8"
                IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{Binding ErrorMessage}"
                     Foreground="{DynamicResource ErrorFgBrush}"
                     FontSize="12"
                     TextWrapping="Wrap"/>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="8">
            <TextBlock Text="(加载中...)"
                       Classes="muted" FontSize="12"
                       IsVisible="{Binding IsLoading}"/>

            <TextBlock Classes="muted" FontSize="12"
                       Text="(暂无任务 — 点 + 添加第一个)"
                       TextWrapping="Wrap"
                       IsVisible="{Binding Tasks.Count, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=0}"/>

            <ItemsControl ItemsSource="{Binding Tasks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ScheduledTaskRowViewModel">
                  <Border Classes="env-row"
                          BorderBrush="{DynamicResource LineSoftBrush}"
                          BorderThickness="0,0,0,1"
                          Padding="0,8">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                      <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="{Binding Name}"
                                     FontSize="13" FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextBrush}"/>
                          <TextBlock Text="{Binding CadenceLabel}"
                                     Classes="muted" FontSize="11"
                                     FontFamily="{StaticResource FontMono}"
                                     VerticalAlignment="Center"/>
                          <TextBlock Text="{Binding StatusLabel}"
                                     Classes="muted" FontSize="11"
                                     FontFamily="{StaticResource FontMono}"
                                     VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Prompt}"
                                   FontSize="11"
                                   Foreground="{DynamicResource Text2Brush}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1"
                                   FontFamily="{StaticResource FontMono}"/>
                        <TextBlock Classes="muted" FontSize="10"
                                   FontFamily="{StaticResource FontMono}">
                          <Run Text="上次运行: "/>
                          <Run Text="{Binding LastRunLabel, Mode=OneWay}"/>
                        </TextBlock>
                      </StackPanel>
                      <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Classes="chrome-button" Padding="6,2"
                                Command="{Binding $parent[ItemsControl].((vm:ScheduledViewModel)DataContext).ResumeCommand}"
                                CommandParameter="{Binding}"
                                IsVisible="{Binding IsPaused}"
                                ToolTip.Tip="恢复">
                          <TextBlock Text="恢复" FontSize="11"/>
                        </Button>
                        <Button Classes="chrome-button" Padding="6,2"
                                Command="{Binding $parent[ItemsControl].((vm:ScheduledViewModel)DataContext).PauseCommand}"
                                CommandParameter="{Binding}"
                                IsVisible="{Binding !IsPaused}"
                                ToolTip.Tip="暂停">
                          <TextBlock Text="暂停" FontSize="11"/>
                        </Button>
                        <Button Classes="chrome-button" Padding="6,2"
                                Command="{Binding $parent[ItemsControl].((vm:ScheduledViewModel)DataContext).RunNowCommand}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="记录运行 (Wave 9 first slice — 真实 prompt 执行待 follow-up)">
                          <TextBlock Text="记录运行" FontSize="11"/>
                        </Button>
                        <Button Classes="chrome-button" Padding="6,2"
                                Command="{Binding $parent[ItemsControl].((vm:ScheduledViewModel)DataContext).RemoveCommand}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="删除">
                          <TextBlock Text="删除" FontSize="11"/>
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
