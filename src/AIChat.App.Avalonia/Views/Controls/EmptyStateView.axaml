<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:AIChat.App.Avalonia.Views.Controls"
             x:Class="AIChat.App.Avalonia.Views.Controls.EmptyStateView"
             x:Name="Self"
             mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="520">

  <!--
    Empty-state shell — split out from MainWindow.axaml so the
    "first impression" copy (hero + first-run CTAs + 4 quick-action
    cards) lives in one place, editable in isolation, and the
    conversation view doesn't have to scroll past 130 lines of
    greeting chrome to find the actual feed.

    Bound to its own EmptyStateViewModel (a thin projection of
    MainWindowViewModel) so the XAML has a strong DataType and
    the compiler validates every binding.

    SubGreeting / Greeting switch via HasProject so the user
    sees different copy when they haven't added a project yet
    vs. when one is loaded. Quick-action cards only show when
    a project is loaded because their prompts reference
    project-specific work and would be hollow without one.
  -->
  <StackPanel Spacing="32"
              VerticalAlignment="Center"
              HorizontalAlignment="Center"
              MaxWidth="620">

    <StackPanel Spacing="8" HorizontalAlignment="Center">
      <TextBlock Text="{Binding #Self.Greeting}"
                 Classes="hero-title"
                 HorizontalAlignment="Center"/>
      <TextBlock Text="{Binding #Self.SubGreeting}"
                 Classes="muted"
                 FontSize="13"
                 HorizontalAlignment="Center"
                 TextAlignment="Center"
                 MaxWidth="460"
                 TextWrapping="Wrap"/>
    </StackPanel>

    <!--
      First-run CTAs. Visible only when no project is loaded —
      the 4 quick-action cards below reference project-specific
      work and would be hollow without one. Both buttons route
      through the host's existing AddProject handler and
      OpenSettingsCommand, so ⌘O / ⌘, / palette / empty state
      stay in lockstep.
    -->
    <StackPanel Orientation="Horizontal"
                Spacing="12"
                HorizontalAlignment="Center"
                IsVisible="{Binding !#Self.HasProject}">
      <Button Classes="quick-action"
              Width="200" Height="76"
              Click="OnAddProjectClick"
              ToolTip.Tip="从本地选一个代码仓库 (⌘O)">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource AccentSoftBrush}">
            <Path Data="M3 5 a2 2 0 0 1 2 -2 h4 l2 2 h8 a2 2 0 0 1 2 2 v10 a2 2 0 0 1 -2 2 H5 a2 2 0 0 1 -2 -2 Z M3 9 H20"
                  Stroke="{StaticResource AccentBrush}"
                  StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                  Width="16" Height="16" Stretch="Uniform"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="添加项目" FontWeight="SemiBold" Classes="body" VerticalAlignment="Center" FontSize="14"/>
        </StackPanel>
      </Button>
      <Button Classes="quick-action"
              Width="200" Height="76"
              Command="{Binding #Self.OpenSettingsCommand}"
              ToolTip.Tip="配置模型提供方 (⌘,)">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource AccentSoftBrush}">
            <Path Data="M4 4 H20 V20 H4 Z M9 9 H15 V15 H9 Z"
                  Stroke="{StaticResource AccentBrush}"
                  StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                  Width="16" Height="16" Stretch="Uniform"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="配置模型" FontWeight="SemiBold" Classes="body" VerticalAlignment="Center" FontSize="14"/>
        </StackPanel>
      </Button>
    </StackPanel>

    <!--
      4 quick-action cards (visible only with a project loaded).
      Each card's full prompt is on the Button.Tag so the host
      can read it on Click and forward to the prompt input. The
      ToolTip.Tip duplicates the prompt for hover-preview.
    -->
    <ItemsControl HorizontalAlignment="Center"
                  IsVisible="{Binding #Self.HasProject}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Rows="2" Columns="2"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <Button Classes="quick-action" Width="280" Height="76"
              Tag="检查发布前风险并修复失败的测试"
              ToolTip.Tip="检查发布前风险并修复失败的测试"
              Click="OnQuickActionClick">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource AccentSoftBrush}">
            <Path Data="M5 12 l4 4 L19 6"
                  Stroke="{StaticResource AccentBrush}"
                  StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                  Width="16" Height="16" Stretch="Uniform"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="发布前检查" FontWeight="SemiBold" Classes="body" VerticalAlignment="Center" FontSize="14"/>
        </StackPanel>
      </Button>
      <Button Classes="quick-action" Width="280" Height="76"
              Tag="挑一段最复杂的函数，重构得更易读、更易测"
              ToolTip.Tip="挑一段最复杂的函数，重构得更易读、更易测"
              Click="OnQuickActionClick">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource AccentSoftBrush}">
            <Path Data="M12 20 H21 M16.5 3.5 a2.121 2.121 0 0 1 3 3 L7 19 L4 20 L5 17 L16.5 3.5 z"
                  Stroke="{StaticResource AccentBrush}"
                  StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                  Width="16" Height="16" Stretch="Uniform"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="重构" FontWeight="SemiBold" Classes="body" VerticalAlignment="Center" FontSize="14"/>
        </StackPanel>
      </Button>
      <Button Classes="quick-action" Width="280" Height="76"
              Tag="整理 README，把功能、快捷键、构建步骤写清楚"
              ToolTip.Tip="整理 README，把功能、快捷键、构建步骤写清楚"
              Click="OnQuickActionClick">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource AccentSoftBrush}">
            <Path Data="M14 2 H6 a2 2 0 0 0 -2 2 v16 a2 2 0 0 0 2 2 h12 a2 2 0 0 0 2 -2 V8 z M14 2 v6 h6"
                  Stroke="{StaticResource AccentBrush}"
                  StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                  Width="16" Height="16" Stretch="Uniform"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="写文档" FontWeight="SemiBold" Classes="body" VerticalAlignment="Center" FontSize="14"/>
        </StackPanel>
      </Button>
      <Button Classes="quick-action" Width="280" Height="76"
              Tag="解释一下当前项目结构和核心数据流"
              ToolTip.Tip="解释一下当前项目结构和核心数据流"
              Click="OnQuickActionClick">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource AccentSoftBrush}">
            <Path Data="M2 12 a10 10 0 1 0 20 0 a10 10 0 1 0 -20 0 M12 6 V12 L16 14"
                  Stroke="{StaticResource AccentBrush}"
                  StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                  Width="16" Height="16" Stretch="Uniform"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="理解项目" FontWeight="SemiBold" Classes="body" VerticalAlignment="Center" FontSize="14"/>
        </StackPanel>
      </Button>
    </ItemsControl>
  </StackPanel>
</UserControl>
