<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AIChat.App.Avalonia.ViewModels"
        xmlns:composition="using:AIChat.App.Avalonia.Composition"
        xmlns:controls="using:AIChat.App.Avalonia.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1240" d:DesignHeight="800"
        x:Class="AIChat.App.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="AIChat"
        MinWidth="1080"
        MinHeight="700"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        CanResize="True"
        Background="Transparent">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <!--
      Layered overlay stack (back to front):
        1. Main surface (slim titlebar + 2-col content + status bar)
        2. Toasts (bottom-right)
        3. Command palette (top-anchored modal, search-first)
        4. Settings modal (centered, provider config form)
        5. Tool approval modal (window-modal so it blocks the sidebar)

      1.0 redesign: brand mark, 264px sidebar, borderless composer, AI
      bubble mark, lean empty state, window-modal tool approval.
    -->
    <Grid>
        <Border Background="{StaticResource BgBrush}" CornerRadius="18" ClipToBounds="True">
            <Grid RowDefinitions="48,*,32">

                <!-- ============== Titlebar (slim, with brand mark) ============== -->
                <Grid Grid.Row="0"
                      ColumnDefinitions="Auto,*,Auto"
                      Margin="20,0,12,0"
                      ColumnSpacing="12"
                      Background="Transparent"
                      PointerPressed="TitleBar_OnPointerPressed">
                    <!-- Brand mark: a single solid teal dot. v1.1: dropped the
                         3-dot constellation in favor of a single dot — reads
                         less like an AI-startup logo, more like a private
                         tool someone built for themselves. -->
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="24" Height="24">
                            <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="AIChat" FontFamily="{StaticResource FontSans}" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid Grid.Column="2" ColumnDefinitions="Auto,Auto" ColumnSpacing="1" VerticalAlignment="Center">
                        <Button Grid.Column="0" Classes="chrome-button" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="切换主题 (⌘⇧T)">
                            <Path Data="M12 4 V2 M12 22 V20 M4 12 H2 M22 12 H20 M5.5 5.5 L4.1 4.1 M19.9 19.9 L18.5 18.5 M5.5 18.5 L4.1 19.9 M19.9 4.1 L18.5 5.5 M12 8 a4 4 0 1 0 0 8 a4 4 0 1 0 0 -8"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="1.6" StrokeLineCap="Round"
                                  Width="16" Height="16" Stretch="Uniform"/>
                        </Button>
                        <Button Grid.Column="1" Classes="chrome-button" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="设置 (⌘,)">
                            <Path Data="M4 4 H20 V20 H4 Z M9 9 H15 V15 H9 Z"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="1.6" StrokeJoin="Round"
                                  Width="16" Height="16" Stretch="Uniform"/>
                        </Button>
                        <Button Classes="chrome-button" Click="Minimize_OnClick" ToolTip.Tip="最小化">
                            <Path Data="M5 12 H19"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="1.6" StrokeLineCap="Round"
                                  Width="16" Height="16" Stretch="Uniform"/>
                        </Button>
                        <Button Classes="chrome-button" Click="MaximizeRestore_OnClick" ToolTip.Tip="最大化">
                            <Path Data="M4 4 H20 V20 H4 Z"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="1.6" StrokeJoin="Round"
                                  Width="16" Height="16" Stretch="Uniform"/>
                        </Button>
                        <Button Classes="chrome-button close" Click="Close_OnClick" ToolTip.Tip="关闭">
                            <Path Data="M6 6 L18 18 M18 6 L6 18"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="1.6" StrokeLineCap="Round"
                                  Width="16" Height="16" Stretch="Uniform"/>
                        </Button>
                    </Grid>
                </Grid>

                <!-- ============== Main: 2-col (sidebar 264 + flex) ============== -->
                <Grid Grid.Row="1" ColumnDefinitions="264,*" Margin="14,4,14,6" ColumnSpacing="14">

                    <!-- ========== Sidebar ========== -->
                    <!--
                      v1.2 list-style sidebar (Linear / Notion look):
                        1. Task types (5 fixed items, first one = new task)
                        2. 项目 section — bound to Sidebar.Projects
                        3. 最近 section — bound to ConversationList.Conversations
                      No prominent "新对话" button, no search input, no bottom
                      status block. Every row is icon + single-line text;
                      selected state = soft gray rounded background.
                    -->
                    <Border Grid.Column="0"
                            Classes="rail"
                            Padding="{StaticResource Padding2}"
                            BorderBrush="{StaticResource LineSoftBrush}"
                            BorderThickness="0,0,1,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="2">

                                <!-- 1. New task (only entry — the 4 placeholder items I added
                                     earlier (拉取请求/站点/已安排/插件) were dropped because
                                     they had no backing functionality. UI without
                                     commands is just noise.) -->
                                <Button Classes="sidebar-row" Command="{Binding NewConversationCommand}" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Path Data="M3 21 L8 14 L11 17 L21 5 M14 5 H21 V12"
                                              Stroke="{Binding $parent[Button].Foreground}"
                                              StrokeThickness="1.5" StrokeLineCap="Round"
                                              Width="16" Height="16" Stretch="Uniform"
                                              VerticalAlignment="Center"/>
                                        <TextBlock Text="新建任务" FontFamily="{StaticResource FontSans}" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- 2. 项目 section -->
                                <TextBlock Text="项目" Classes="section-title" Margin="4,16,0,6"/>
                                <ItemsControl ItemsSource="{Binding Sidebar.Projects}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ProjectCardViewModel">
                                            <Button Classes="sidebar-row"
                                                    Tag="{Binding Id}"
                                                    Click="ProjectButton_OnClick"
                                                    Classes.selected="{Binding IsSelected}"
                                                    ToolTip.Tip="{Binding Name}"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <Path Data="M3 5 a2 2 0 0 1 2 -2 h4 l2 2 h8 a2 2 0 0 1 2 2 v10 a2 2 0 0 1 -2 2 H5 a2 2 0 0 1 -2 -2 Z"
                                                          Stroke="{Binding $parent[Button].Foreground}"
                                                          StrokeThickness="1.5" StrokeLineCap="Round"
                                                          Width="16" Height="16" Stretch="Uniform"
                                                          VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource FontSans}" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 3. 最近 section -->
                                <TextBlock Text="最近" Classes="section-title" Margin="4,16,0,6"/>
                                <ItemsControl ItemsSource="{Binding ConversationList.Conversations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ConversationCardViewModel">
                                            <Button Classes="sidebar-row"
                                                    Tag="{Binding Id}"
                                                    Click="ConversationButton_OnClick"
                                                    Classes.selected="{Binding IsSelected}"
                                                    ToolTip.Tip="{Binding Title}"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch">
                                                <TextBlock Text="{Binding Title}"
                                                           FontFamily="{StaticResource FontSans}"
                                                           FontSize="13"
                                                           Foreground="{StaticResource Text2Brush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="1"/>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- ========== Main column ========== -->
                    <Grid Grid.Column="1">

                        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="{StaticResource Space3}">

                            <!-- Slim page header: just project breadcrumb + readiness pill. No hero.
                                 Hero lives in the empty state so the conversation starts at the top. -->
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding HasProject}">
                                    <Path Data="M4 4 H20 V20 H4 Z M4 9 H20"
                                          Stroke="{StaticResource MutedBrush}"
                                          StrokeThickness="1.4" StrokeJoin="Round"
                                          Width="12" Height="12" Stretch="Uniform"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Sidebar.SelectedProjectName}" Classes="muted" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Border Classes="badge success" IsVisible="{Binding IsReady}">
                                        <TextBlock Text="可运行" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SuccessBadgeFgBrush}"/>
                                    </Border>
                                    <Border Classes="badge warning" IsVisible="{Binding NeedsConfiguration}">
                                        <TextBlock Text="需要密钥" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource WarningBadgeFgBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Conversation: empty state OR scrollable bubbles -->
                            <Border Grid.Row="1" Classes="panel" Padding="0">
                                <Panel>
                                    <!-- Real conversation: bubbles, centered, max-width 720. AI = transparent + hairline -->
                                    <Grid IsVisible="{Binding ActivityFeed.HasConversation}">
                                        <ScrollViewer x:Name="ConversationScroll" Padding="20,12">
                                            <ItemsControl ItemsSource="{Binding ActivityFeed.Activity}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ActivityItemViewModel">
                                                        <Grid Classes="bubble-enter" Margin="0,0,0,12">
                                                            <!-- AI bubble: a single small dot on the left, document-section card.
                                                                 v1.1 polish: dropped the 3-dot "constellation" mark that read
                                                                 too much like an AI-startup brand; a single filled dot in the
                                                                 accent tone reads as a person-typed bullet, less corporate. -->
                                                            <Grid IsVisible="{Binding IsAssistantBubble}"
                                                                  HorizontalAlignment="Left"
                                                                  MaxWidth="720"
                                                                  ColumnDefinitions="Auto,*"
                                                                  ColumnSpacing="10">
                                                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="{StaticResource SurfaceSunkenBrush}" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="1" VerticalAlignment="Top">
                                                                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <StackPanel Grid.Column="1" Spacing="4">
                                                                    <Grid ColumnDefinitions="*,Auto">
                                                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource Text2Brush}" FontWeight="SemiBold" FontSize="12"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding Status}" Classes="muted" FontSize="11" Margin="10,0,0,0"/>
                                                                    </Grid>
                                                                    <Border Classes="bubble-ai">
                                                                        <Panel>
                                                                            <controls:MarkdownTextBlock IsVisible="{Binding !IsThinking}"
                                                                                                        Markdown="{Binding Detail}"
                                                                                                        Foreground="{Binding TextForeground}"
                                                                                                        FontSize="14"
                                                                                                        TextWrapping="Wrap"/>
                                                                            <StackPanel IsVisible="{Binding IsThinking}" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                                                <Ellipse Classes="thinking-dot" Width="6" Height="6"/>
                                                                                <Ellipse Classes="thinking-dot delay-1" Width="6" Height="6"/>
                                                                                <Ellipse Classes="thinking-dot delay-2" Width="6" Height="6"/>
                                                                            </StackPanel>
                                                                        </Panel>
                                                                    </Border>
                                                                </StackPanel>
                                                            </Grid>

                                                            <!-- User bubble: right-aligned, soft accent card with dark text -->
                                                            <StackPanel IsVisible="{Binding IsUserBubble}"
                                                                        HorizontalAlignment="Right"
                                                                        MaxWidth="720"
                                                                        Spacing="4">
                                                                <TextBlock Text="{Binding Status}" Classes="muted" FontSize="11" HorizontalAlignment="Right"/>
                                                                <!-- User bubble is a Button (not a Border) so the
                                                                     user can click it to copy the message back into
                                                                     the input for editing + resending. The
                                                                     bubble-user class still drives the visual so the
                                                                     affordance looks identical to the read-only
                                                                     variant. -->
                                                                <Button Classes="bubble-user"
                                                                        MaxWidth="720"
                                                                        Tag="{Binding Detail}"
                                                                        Click="EditUserBubble_OnClick"
                                                                        ToolTip.Tip="点击编辑">
                                                                    <controls:MarkdownTextBlock Markdown="{Binding Detail}"
                                                                                                Foreground="{Binding TextForeground}"
                                                                                                FontSize="14"
                                                                                                TextWrapping="Wrap"/>
                                                                </Button>
                                                            </StackPanel>

                                                            <!-- System / tool message: centered, no bubble -->
                                                            <StackPanel IsVisible="{Binding IsSystemBubble}"
                                                                        HorizontalAlignment="Center"
                                                                        MaxWidth="640"
                                                                        Spacing="2">
                                                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>

                                    <!-- Empty state: lean — hero + 4 quick-action cards. No sub-greeting, no kbd-hint row.
                                         ToolTip.Tip on each card shows the full prompt. -->
                                    <StackPanel IsVisible="{Binding !ActivityFeed.HasConversation}"
                                                Spacing="32"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                MaxWidth="620">
                                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                                            <!-- v1.1: less AI-startup, more "real person tool" — short, casual, no "ask AIChat" framing. -->
                                            <TextBlock Text="想做点什么？"
                                                       Classes="hero-title"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <ItemsControl HorizontalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="2" Columns="2"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <Button Classes="quick-action" Width="280" Height="76" Tag="检查发布前风险并修复失败的测试" ToolTip.Tip="检查发布前风险并修复失败的测试" Click="EmptyStateCard_OnClick">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource AccentSoftBrush}">
                                                        <Path Data="M5 12 l4 4 L19 6"
                                                              Stroke="{StaticResource AccentBrush}"
                                                              StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                                                              Width="16" Height="16" Stretch="Uniform"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="发布前检查" FontWeight="SemiBold" Classes="body" VerticalAlignment="Center" FontSize="14"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="quick-action" Width="280" Height="76" Tag="重构 UserDialog，把 prompt 模板抽到独立文件" ToolTip.Tip="重构 UserDialog，把 prompt 模板抽到独立文件" Click="EmptyStateCard_OnClick">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource AccentSoftBrush}">
                                                        <Path Data="M12 20 H21 M16.5 3.5 a2.121 2.121 0 0 1 3 3 L7 19 L4 20 L5 17 L16.5 3.5 z"
                                                              Stroke="{StaticResource AccentBrush}"
                                                              StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                                                              Width="16" Height="16" Stretch="Uniform"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="重构" FontWeight="SemiBold" Classes="body" VerticalAlignment="Center" FontSize="14"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="quick-action" Width="280" Height="76" Tag="整理 README，把功能、快捷键、构建步骤写清楚" ToolTip.Tip="整理 README，把功能、快捷键、构建步骤写清楚" Click="EmptyStateCard_OnClick">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource AccentSoftBrush}">
                                                        <Path Data="M14 2 H6 a2 2 0 0 0 -2 2 v16 a2 2 0 0 0 2 2 h12 a2 2 0 0 0 2 -2 V8 z M14 2 v6 h6"
                                                              Stroke="{StaticResource AccentBrush}"
                                                              StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                                                              Width="16" Height="16" Stretch="Uniform"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="写文档" FontWeight="SemiBold" Classes="body" VerticalAlignment="Center" FontSize="14"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="quick-action" Width="280" Height="76" Tag="解释一下当前项目结构和核心数据流" ToolTip.Tip="解释一下当前项目结构和核心数据流" Click="EmptyStateCard_OnClick">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource AccentSoftBrush}">
                                                        <Path Data="M2 12 a10 10 0 1 0 20 0 a10 10 0 1 0 -20 0 M12 6 V12 L16 14"
                                                              Stroke="{StaticResource AccentBrush}"
                                                              StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                                                              Width="16" Height="16" Stretch="Uniform"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="理解项目" FontWeight="SemiBold" Classes="body" VerticalAlignment="Center" FontSize="14"/>
                                                </StackPanel>
                                            </Button>
                                        </ItemsControl>
                                    </StackPanel>
                                </Panel>
                            </Border>

                            <!--
                              Floating composer (v1.1 revert to 5c1eace look).
                              Surface + RadiusLg + Elevation3 shadow, no 1px
                              border. The input "lifts" off the page. Focus
                              indicator = shadow deepens one step (no blue
                              ring inside the cream block).

                              5*,40*,5* = 10% / 80% / 10% of the main column
                              width, so the composer always fills 80% of the
                              available chat area regardless of window size.
                            -->
                            <Grid Grid.Row="2" ColumnDefinitions="5*,40*,5*">
                                <Border Grid.Column="1" Classes="input-floating">
                                    <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                                        <TextBox x:Name="PromptInput"
                                                 Text="{Binding DraftPrompt}"
                                                 PlaceholderText="{Binding PromptPlaceholder}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 Height="72"
                                                 MaxHeight="200"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="4,10,4,6"
                                                 FontFamily="{StaticResource FontSans}"
                                                 FontSize="14"
                                                 VerticalContentAlignment="Top"
                                                 VerticalAlignment="Top"
                                                 KeyDown="PromptInput_OnKeyDown"/>

                                        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                                            <!-- Left: + attach, model chip. Right: send. The center
                                                 column (where ⌘⏎ used to live) is gone, and the
                                                 read-only toggle is dropped — single teal icon
                                                 with no label read as a stray warning badge. -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Button Classes="icon-toggle" ToolTip.Tip="附加文件 (⌘⇧A)">
                                                    <Path Data="M12 5 V19 M5 12 H19"
                                                          Stroke="{Binding $parent[Button].Foreground}"
                                                          StrokeThickness="1.6" StrokeLineCap="Round"
                                                          Width="14" Height="14" Stretch="Uniform"/>
                                                </Button>
                                                <Border Classes="model-chip" MaxWidth="200">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}"/>
                                                        <TextBlock Text="{Binding ActiveProvider}" FontSize="12" Foreground="{StaticResource Text2Brush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="80" FontFamily="{StaticResource FontSans}"/>
                                                        <TextBlock Text="·" FontSize="12" Foreground="{StaticResource MutedBrush}" FontFamily="{StaticResource FontSans}"/>
                                                        <TextBlock Text="{Binding ActiveModel}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="80" FontFamily="{StaticResource FontSans}"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            <!-- Send / Stop swap: same grid cell, only one
                                                 visible at a time. Stop is enabled while
                                                 IsRunning so a misclick on the now-disabled
                                                 send can't accidentally fire another run. -->
                                            <!-- Retry: only shown when CanRetry (last run
                                                 failed or was stopped). Sits between the
                                                 tools and the send button so it's the obvious
                                                 next step. -->
                                            <Button Grid.Column="1"
                                                    Classes="retry-button"
                                                    Command="{Binding RetryLastTaskCommand}"
                                                    IsVisible="{Binding CanRetry}"
                                                    ToolTip.Tip="重试上一次任务 (⌘R)">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Path Data="M5 12 a7 7 0 1 0 1.5 -4.2 M5 4 V8 H9"
                                                          Stroke="{Binding $parent[Button].Foreground}"
                                                          StrokeThickness="1.6" StrokeLineCap="Round"
                                                          Width="14" Height="14" Stretch="Uniform"
                                                          VerticalAlignment="Center"/>
                                                    <TextBlock Text="重试" FontFamily="{StaticResource FontSans}" FontSize="12" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="2"
                                                    Classes="send-button"
                                                    Command="{Binding SendTaskCommand}"
                                                    IsEnabled="{Binding !IsRunning}"
                                                    IsVisible="{Binding !IsRunning}"
                                                    ToolTip.Tip="发送 (⌘↵)">
                                                <Path Data="M5 12 L19 12 M12 5 L19 12 L12 19"
                                                      Stroke="{Binding $parent[Button].Foreground}"
                                                      StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                                      Width="16" Height="16" Stretch="Uniform"/>
                                            </Button>
                                            <Button Grid.Column="2"
                                                    Classes="stop-button"
                                                    Command="{Binding StopTaskCommand}"
                                                    IsVisible="{Binding IsRunning}"
                                                    ToolTip.Tip="停止 (⌘.)">
                                                <Path Data="M6 6 H18 V18 H6 Z"
                                                      Stroke="{Binding $parent[Button].Foreground}"
                                                      StrokeThickness="2" StrokeLineCap="Round"
                                                      Width="16" Height="16" Stretch="Uniform"/>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ============== Status bar (mono, single line) ============== -->
                <Border Grid.Row="2" Background="{StaticResource SurfaceSunkenBrush}">
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="20,0,20,0" ColumnSpacing="14">
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontFamily="{StaticResource FontMono}"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="480"/>
                        <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto" ColumnSpacing="6" VerticalAlignment="Center">
                            <Border Background="{StaticResource LineBrush}" CornerRadius="2" Height="3" Width="80" ClipToBounds="True" VerticalAlignment="Center">
                                <Border Background="{StaticResource AccentBrush}" CornerRadius="2" Height="3" HorizontalAlignment="Left" Width="{Binding ContextBudgetWidthInMini}"/>
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ContextBudgetPercent, StringFormat={}{0}%}"
                                       FontFamily="{StaticResource FontMono}"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding StatusBarModel}"
                                   FontFamily="{StaticResource FontMono}"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="320"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ============== Toasts (bottom-right) ============== -->
        <ItemsControl ItemsSource="{Binding Toasts}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="20,20,20,52">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="8" Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="composition:ToastItem">
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="{StaticResource Padding3}"
                            MinWidth="240"
                            MaxWidth="380"
                            BoxShadow="{StaticResource ElevationToastShadow}">
                        <TextBlock Text="{Binding Message}" Classes="body" TextWrapping="Wrap"/>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ============== Command palette (Cmd+K) — click outside to close ============== -->
        <Border IsVisible="{Binding IsCommandPaletteOpen}"
                Background="{StaticResource ScrimBrush}"
                KeyDown="CommandPalette_OnKeyDown"
                PointerPressed="CommandPaletteScrim_OnClick">
            <Border Background="{StaticResource SurfaceBrush}"
                    Width="640"
                    MaxHeight="480"
                    Padding="{StaticResource Padding3}"
                    CornerRadius="{StaticResource RadiusLg}"
                    BoxShadow="{StaticResource Elevation5Shadow}"
                    VerticalAlignment="Top"
                    Margin="0,80,0,0"
                    PointerPressed="CommandPaletteContent_OnPointerPressed">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Path Grid.Column="0"
                              Data="M11 19 a8 8 0 1 0 0 -16 a8 8 0 1 0 0 16 M21 21 L16.65 16.65"
                              Stroke="{StaticResource MutedBrush}"
                              StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                              Width="18" Height="18" Stretch="Uniform"
                              VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                 x:Name="CommandSearchInput"
                                 Text="{Binding CommandPalette.SearchText, Mode=TwoWay}"
                                 PlaceholderText="搜索命令、操作、设置…"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="14"
                                 KeyDown="CommandPalette_OnKeyDown"/>
                        <Border Grid.Column="2" Classes="kbd-pill">
                            <TextBlock Text="ESC" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Classes="section-divider" Margin="0,8"/>

                    <ListBox Grid.Row="1" Classes="command-list"
                             ItemsSource="{Binding CommandPalette.FilteredCommands}"
                             SelectedIndex="{Binding CommandPalette.SelectedIndex, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0,4"
                             MaxHeight="360">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:CommandItem">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="8,6">
                                    <Border Grid.Column="0"
                                            Width="28" Height="28"
                                            CornerRadius="6"
                                            Background="{StaticResource SurfaceSunkenBrush}">
                                        <Path Data="{Binding Glyph}"
                                              Stroke="{StaticResource MutedBrush}"
                                              StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                                              Width="16" Height="16" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Classes="body" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Subtitle}" Classes="muted" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Classes="kbd-pill" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Shortcut}" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Border>

        <!-- ============== Settings modal (Cmd+,) — click outside to close ============== -->
        <Border IsVisible="{Binding IsSettingsOpen}"
                Background="{StaticResource ScrimBrush}"
                PointerPressed="SettingsScrim_OnClick">
            <Border Background="{StaticResource SurfaceBrush}"
                    Width="720"
                    MaxHeight="600"
                    Padding="{StaticResource Padding6}"
                    CornerRadius="{StaticResource RadiusLg}"
                    BoxShadow="{StaticResource Elevation4Shadow}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    PointerPressed="SettingsContent_OnPointerPressed">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4">
                            <TextBlock Text="设置" Classes="page-title"/>
                            <TextBlock Text="配置模型提供方、API Key 和默认行为。" Classes="muted"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="chrome-button" Command="{Binding CloseSettingsCommand}" ToolTip.Tip="关闭 (Esc)">
                            <Path Data="M6 6 L18 18 M18 6 L6 18"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="1.6" StrokeLineCap="Round"
                                  Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="模型提供方" Classes="section-title"/>
                                <ComboBox ItemsSource="{Binding Provider.ProviderTemplates}"
                                          SelectedItem="{Binding Provider.SelectedProviderTemplate}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ProviderTemplateViewModel">
                                            <TextBlock Text="{Binding Name}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="10">
                                <TextBox Grid.Row="0" Grid.Column="0"
                                         Text="{Binding Provider.ProviderApiKey}"
                                         PlaceholderText="API Key"
                                         PasswordChar="●"/>
                                <TextBox Grid.Row="0" Grid.Column="1"
                                         Text="{Binding Provider.ProviderModel}"
                                         PlaceholderText="模型 ID"/>
                                <TextBox Grid.Row="1" Grid.ColumnSpan="2"
                                         Text="{Binding Provider.ProviderBaseUrl}"
                                         PlaceholderText="Base URL"/>
                            </Grid>

                            <Border Classes="section-divider" Margin="0,2"/>

                            <StackPanel Spacing="8">
                                <TextBlock Text="可用的提供方" Classes="section-title"/>
                                <ItemsControl ItemsSource="{Binding Provider.AdvancedProviders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ProviderCardViewModel">
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Classes="body" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding DefaultModel}" Classes="muted"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <Border Classes="section-divider" Margin="0,2"/>

                            <StackPanel Spacing="8">
                                <TextBlock Text="安全策略" Classes="section-title"/>
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8">
                                    <TextBlock Text="只读模式" Classes="body" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding NoWriteMode}"/>
                                    <TextBlock Grid.Row="1" Text="修改后自动验证" Classes="body" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding AutoVerify}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                        <Button Classes="secondary" Command="{Binding Provider.TestProviderCommand}" Content="测试连接"/>
                        <Button Classes="primary" Command="{Binding Provider.SaveProviderCommand}" Content="保存配置"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
