<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate x:Key="ProviderOptionTemplate">
        <TextBlock Text="{Binding Name}"
                   Foreground="#1E252E"
                   TextTrimming="CharacterEllipsis" />
    </DataTemplate>

    <DataTemplate x:Key="ConfiguredProviderTemplate">
        <TextBlock Text="{Binding DisplayName}"
                   Foreground="#1E252E"
                   TextTrimming="CharacterEllipsis" />
    </DataTemplate>

    <DataTemplate x:Key="ModelOptionTemplate">
        <TextBlock Text="{Binding DisplayName}"
                   Foreground="#1E252E"
                   TextTrimming="CharacterEllipsis" />
    </DataTemplate>

    <DataTemplate x:Key="SelectionOptionTemplate">
        <TextBlock Text="{Binding Name}"
                   Foreground="#1E252E"
                   TextTrimming="CharacterEllipsis" />
    </DataTemplate>
</ResourceDictionary>
