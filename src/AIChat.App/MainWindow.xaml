                        </Border>

                        <TextBlock Grid.Row="2"
                                   Text="{Binding SelectedInputArtifactPreview.StoredPath}"
                                   Margin="0,10,0,0"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="#748092"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
            </Grid>
            <!-- Call-detail overlay for inspecting the exact provider request/response. -->
            <Grid Grid.RowSpan="2" Background="#B8EEF1F4">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCallDetailsOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Border Width="940"
                        Height="640"
                        MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                        MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                        Margin="24"
                        Padding="22"
                        Background="#FFFFFF"
                        CornerRadius="10"
                        BorderBrush="#DCE3EC"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="{Binding CallDetailsTitle}" FontSize="20" FontWeight="SemiBold" Foreground="#1E252E" />
                                <TextBlock Text="查看每次模型调用的入参 JSON 和出参 JSON。"
                                           Margin="0,6,0,0"
                                           Foreground="#748092" />
                            </StackPanel>
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding CloseCallDetailsCommand}"
                                    Content="×"
                                    Style="{StaticResource IconButtonStyle}"
                                    HorizontalAlignment="Right" />
                        </DockPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" BorderBrush="#E2E7EE" BorderThickness="1" CornerRadius="8" Background="#F8FAFC">
                                <Grid>
                                    <ListBox ItemsSource="{Binding CurrentCallDetails}"
                                             SelectedItem="{Binding SelectedCallDetail, Mode=TwoWay}"
                                             ItemTemplate="{StaticResource CallDetailListTemplate}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Padding="6"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                    <TextBlock Text="暂无调用记录"
                                               Foreground="#98A2B0"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentCallDetails.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="16" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" BorderBrush="#E2E7EE" BorderThickness="1" CornerRadius="8" Background="#FFFFFF">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="调用入参 JSON" Margin="14,12,14,8" FontWeight="SemiBold" Foreground="#303A47" />
                                        <Grid Grid.Row="1" Margin="12,0,12,12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Border x:Name="RequestSummaryBadge"
                                                    Margin="0,0,0,8"
                                                    Padding="10,6"
                                                    CornerRadius="7"
                                                    Background="#EEF5F3"
                                                    BorderBrush="#D9E9E5"
                                                    BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedCallDetail.HasRequestSummary}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding SelectedCallDetail.RequestSummary}"
                                                           Foreground="#3E6F68"
                                                           FontSize="12"
                                                           TextWrapping="Wrap" />
                                            </Border>
                                            <TextBox Grid.Row="1"
                                                     Text="{Binding SelectedCallRequestJson, Mode=OneWay}"
                                                     Style="{StaticResource JsonTextBoxStyle}" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="2" BorderBrush="#E2E7EE" BorderThickness="1" CornerRadius="8" Background="#FFFFFF">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <DockPanel Margin="14,12,14,8">
                                            <TextBlock Text="调用出参 JSON" FontWeight="SemiBold" Foreground="#303A47" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding SelectedCallDetail.ResponseSummary}"
                                                       Margin="12,0,0,0"
                                                       Foreground="#748092"
                                                       FontSize="12"
                                                       VerticalAlignment="Center" />
                                            <CheckBox DockPanel.Dock="Right"
                                                      Content="展开原始事件"
                                                      IsChecked="{Binding ShowSelectedCallRawEvents, Mode=TwoWay}"
                                                      Foreground="#596473"
                                                      FontSize="12"
                                                      HorizontalAlignment="Right" />
                                        </DockPanel>
                                        <TextBox Grid.Row="1"
                                                 Text="{Binding SelectedCallResponseJson, Mode=OneWay}"
                                                 Margin="12,0,12,12"
                                                 Style="{StaticResource JsonTextBoxStyle}" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
            <!-- Settings overlay for provider keys, model choice, and generation knobs. -->
            <Grid Grid.RowSpan="2" Background="#B8EEF1F4">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Border Width="780"
                        Height="560"
                        MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                        Margin="24"
                        Padding="24"
                        Background="#FFFFFF"
                        CornerRadius="10"
                        BorderBrush="#DCE3EC"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel>
                            <StackPanel>
                                <TextBlock Text="项目设置" FontSize="22" FontWeight="SemiBold" Foreground="#1E252E" />
                                <TextBlock Text="管理当前客户端可用的模型服务。"
                                           Margin="0,6,0,0"
                                           Foreground="#748092" />
                            </StackPanel>
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding CloseSettingsCommand}"
                                    Content="×"
                                    Style="{StaticResource IconButtonStyle}"
                                    HorizontalAlignment="Right" />
                        </DockPanel>

                        <TabControl Grid.Row="1"
                                    Margin="0,20,0,22"
                                    VerticalAlignment="Stretch">
                            <TabItem Header="模型">
                                <ScrollViewer Style="{StaticResource ModernScrollViewerStyle}"
                                              VerticalAlignment="Stretch"
                                              VerticalScrollBarVisibility="Auto"
                                              PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,8">
                                    <TextBlock Text="模型提供商" Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox ItemsSource="{Binding ProviderOptions}"
                                              SelectedValue="{Binding NewProviderTemplateId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Id"
                                              ItemTemplate="{StaticResource ProviderOptionTemplate}"
                                              Padding="12,0" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,8">
                                    <TextBlock Text="API Key" Style="{StaticResource FieldLabelStyle}" />
                                    <Grid>
                                        <TextBox Text="{Binding NewProviderApiKey, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource SettingsTextBoxStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNewProviderApiKeyVisible}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <PasswordBox x:Name="NewProviderPasswordBox"
                                                     PasswordChanged="NewProviderPasswordBox_PasswordChanged">
                                            <PasswordBox.Style>
                                                <Style TargetType="PasswordBox" BasedOn="{StaticResource SettingsPasswordBoxStyle}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNewProviderApiKeyVisible}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </PasswordBox.Style>
                                        </PasswordBox>
                                    </Grid>
                                    <DockPanel Margin="0,12,0,0">
                                        <Button Command="{Binding ToggleNewProviderApiKeyVisibilityCommand}"
                                                Content="显示/隐藏"
                                                Width="92"
                                                Height="40"
                                                Style="{StaticResource SubtleButtonStyle}" />
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Command="{Binding TestProviderConnectionCommand}"
                                                    Content="测试连接"
                                                    Width="92"
                                                    Height="40"
                                                    Margin="0,0,10,0"
                                                    Style="{StaticResource SubtleButtonStyle}" />
                                            <Button Command="{Binding AddConfiguredProviderCommand}"
                                                    Content="添加到已配置列表"
                                                    Width="160"
                                                    Height="40"
                                                    Style="{StaticResource PrimaryButtonStyle}" />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,8">
                                    <TextBlock Text="已配置" Style="{StaticResource FieldLabelStyle}" />
                                    <DockPanel>
                                        <ComboBox ItemsSource="{Binding ConfiguredProviders}"
                                                  SelectedValue="{Binding SelectedConfiguredProviderId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="Id"
                                                  ItemTemplate="{StaticResource ConfiguredProviderTemplate}"
                                                  Padding="12,0"
                                                  DockPanel.Dock="Left"
                                                  Width="564" />
                                        <Button Command="{Binding RemoveConfiguredProviderCommand}"
                                                Content="移除"
                                                Width="86"
                                                Height="38"
                                                Margin="12,0,0,0"
                                                Style="{StaticResource SubtleButtonStyle}" />
                                    </DockPanel>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.Column="0">
                                    <TextBlock Text="当前模型" Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox ItemsSource="{Binding ActiveModelOptions}"
                                              SelectedValue="{Binding SelectedActiveModelId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Id"
                                              ItemTemplate="{StaticResource ModelOptionTemplate}"
                                              Padding="12,0" />
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.Column="2">
                                    <TextBlock Text="模型上下文" Style="{StaticResource FieldLabelStyle}" />
                                    <Border Height="38" Padding="12,0" CornerRadius="10" Background="#F4F6F8" BorderBrush="#DDE2EA" BorderThickness="1">
                                        <TextBlock Text="{Binding Settings.ModelContextLimit, StringFormat={}{0:N0} tokens}"
                                                   Foreground="#303A47"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
                                    <TextBlock Text="当前模型能力" Style="{StaticResource FieldLabelStyle}" />
                                    <Border Padding="12,10" CornerRadius="8" Background="#F5F8FA" BorderBrush="#E1E8EF" BorderThickness="1">
                                        <TextBlock Text="{Binding ActiveModelCapabilitySummary}"
                                                   Foreground="#596473"
                                                   TextWrapping="Wrap" />
                                    </Border>

                                    <Border Margin="0,8,0,0"
                                            Padding="12,10"
                                            CornerRadius="8"
                                            Background="#FFFFFF"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="视觉输入"
                                                           FontWeight="SemiBold"
                                                           Foreground="#1E252E" />
                                                <TextBlock Text="允许把图片和截图附件作为多模态输入发送给当前模型。仅在确认模型支持图片时开启。"
                                                           Margin="0,4,12,0"
                                                           Foreground="#748092"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1"
                                                      IsChecked="{Binding SelectedConfiguredProviderSupportsVisionOverride, Mode=TwoWay}"
                                                      VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Margin="0,4,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasModelParameterOptions}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="执行模型参数" Style="{StaticResource FieldLabelStyle}" />
                                        <ItemsControl ItemsSource="{Binding ModelParameterOptions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="210" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#1E252E" />
                                                            <TextBlock Text="{Binding Description}" Margin="0,4,12,0" Foreground="#748092" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <ComboBox Grid.Column="1"
                                                                  ItemsSource="{Binding Options}"
                                                                  SelectedValue="{Binding SelectedValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  SelectedValuePath="Value"
                                                                  DisplayMemberPath="DisplayName"
                                                                  Padding="12,0" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="工具">
                                <ScrollViewer Style="{StaticResource ModernScrollViewerStyle}"
                                              VerticalAlignment="Stretch"
                                              VerticalScrollBarVisibility="Auto"
                                              PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                                    <StackPanel>
                                        <Border Padding="14"
                                                CornerRadius="8"
                                                Background="#F5F8FA"
                                                BorderBrush="#E1E8EF"
                                                BorderThickness="1"
                                                Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="可发送给模型选择的工具"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="#1E252E" />
                                                <TextBlock Text="只勾选你希望模型在后续请求中可调用的工具。写入、修改和 Shell 工具会影响当前项目，请按测试场景谨慎开启。"
                                                           Margin="0,6,0,0"
                                                           Foreground="#667386"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <Border Padding="12,10"
                                                CornerRadius="8"
                                                Background="#FFF8E1"
                                                BorderBrush="#FFD54F"
                                                BorderThickness="1"
                                                Margin="0,0,0,14">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActiveModelSupportsTools}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⚠"
                                                           FontSize="16"
                                                           Margin="0,0,8,0"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="当前模型不支持工具调用。发送消息时将自动回退到普通聊天模式，Agent 和工具功能不可用。"
                                                           Foreground="#795600"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <Border Padding="14"
                                                CornerRadius="8"
                                                Background="#FFFFFF"
                                                BorderBrush="#E2E8F0"
                                                BorderThickness="1"
                                                Margin="0,0,0,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="120" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="工具轮数预算"
                                                               FontWeight="SemiBold"
                                                               Foreground="#1E252E" />
                                                    <TextBlock Text="Agent 工具调用的硬性上限。达到 80% 时会提醒 Agent 尽快完成。范围 1-100。"
                                                               Margin="0,4,12,0"
                                                               Foreground="#667386"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding AgentMaxToolRounds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         HorizontalContentAlignment="Center"
                                                         VerticalContentAlignment="Center"
                                                         Style="{StaticResource SettingsTextBoxStyle}" />
                                            </Grid>
                                        </Border>

                                        <Border Padding="14"
                                                CornerRadius="8"
                                                Background="#FFFFFF"
                                                BorderBrush="#E2E8F0"
                                                BorderThickness="1"
                                                Margin="0,0,0,14">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="历史自适应策略"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#1E252E" />
                                                        <TextBlock Text="根据最近 Agent 运行记录自动微调预算、Explorer、恢复偏好和写入后验证。"
                                                                   Margin="0,4,12,0"
                                                                   Foreground="#667386"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1"
                                                              IsChecked="{Binding AgentAdaptiveStrategiesEnabled, Mode=TwoWay}"
                                                              VerticalAlignment="Center" />
                                                </Grid>
                                                <UniformGrid Columns="3"
                                                             Margin="0,12,0,0">
                                                    <CheckBox Content="预算 / Explorer"
                                                              IsChecked="{Binding AgentAdaptiveBudgetAndExplorerEnabled, Mode=TwoWay}"
                                                              Margin="0,0,12,0" />
                                                    <CheckBox Content="继续 / 重试偏好"
                                                              IsChecked="{Binding AgentAdaptiveRecoveryEnabled, Mode=TwoWay}"
                                                              Margin="0,0,12,0" />
                                                    <CheckBox Content="写入后验证"
                                                              IsChecked="{Binding AgentAdaptiveAutoVerifyEnabled, Mode=TwoWay}" />
                                                </UniformGrid>
                                            </StackPanel>
                                        </Border>

                                        <Border Padding="14"
                                                CornerRadius="8"
                                                Background="#FFFFFF"
                                                BorderBrush="#E2E8F0"
                                                BorderThickness="1"
                                                Margin="0,0,0,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="120" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="自动验证 Agent 修改"
                                                               FontWeight="SemiBold"
                                                               Foreground="#1E252E" />
                                                    <TextBlock Text="修改项目后自动运行下方验证命令；失败时允许 Agent 根据摘要继续修复。"
                                                               Margin="0,4,12,0"
                                                               Foreground="#667386"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="1"
                                                          IsChecked="{Binding AutoVerifyAgentRuns, Mode=TwoWay}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,18,0" />
                                                <TextBox Grid.Column="2"
                                                         Text="{Binding MaxAutoFixRounds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         HorizontalContentAlignment="Center"
                                                         VerticalContentAlignment="Center"
                                                         ToolTip="自动修复和复验轮数，范围 1-10"
                                                         Style="{StaticResource SettingsTextBoxStyle}" />
                                            </Grid>
                                        </Border>

                                        <Border Padding="14"
                                                CornerRadius="8"
                                                Background="#FFFFFF"
                                                BorderBrush="#E2E8F0"
                                                BorderThickness="1"
                                                Margin="0,0,0,14">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="项目验证命令"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#1E252E" />
                                                        <TextBlock Text="{Binding ProjectVerificationCommandSummary}"
                                                                   Margin="0,4,12,0"
                                                                   Foreground="#667386"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Command="{Binding InferProjectVerificationCommandsCommand}"
                                                            Content="自动推断"
                                                            Width="86"
                                                            Height="30"
                                                            Margin="8,0,0,0"
                                                            Style="{StaticResource SubtleButtonStyle}" />
                                                    <Button Grid.Column="2"
                                                            Command="{Binding AddProjectVerificationCommandCommand}"
                                                            Content="+ 添加"
                                                            Width="72"
                                                            Height="30"
                                                            Margin="8,0,0,0"
                                                            Style="{StaticResource SubtleButtonStyle}" />
                                                </Grid>

                                                <ItemsControl ItemsSource="{Binding ProjectVerificationCommands}" Margin="0,12,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,0,0,8"
                                                                    Padding="12"
                                                                    CornerRadius="8"
                                                                    Background="#F7FAFC"
                                                                    BorderBrush="#DDE6EE"
                                                                    BorderThickness="1">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="120" />
                                                                        <ColumnDefinition Width="130" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="90" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             Margin="0,0,8,0"
                                                                             VerticalContentAlignment="Center"
                                                                             Style="{StaticResource SettingsTextBoxStyle}" />
                                                                    <TextBox Grid.Column="1"
                                                                             Text="{Binding CommandText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             Margin="0,0,8,0"
                                                                             VerticalContentAlignment="Center"
                                                                             Style="{StaticResource SettingsTextBoxStyle}" />
                                                                    <TextBox Grid.Column="2"
                                                                             Text="{Binding Target, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             Margin="0,0,8,0"
                                                                             VerticalContentAlignment="Center"
                                                                             ToolTip="相对项目根目录的 .sln/.csproj 或目录；留空则使用项目根目录"
                                                                             Style="{StaticResource SettingsTextBoxStyle}" />
                                                                    <TextBox Grid.Column="3"
                                                                             Text="{Binding TimeoutSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             Margin="0,0,8,0"
                                                                             HorizontalContentAlignment="Center"
                                                                             VerticalContentAlignment="Center"
                                                                             ToolTip="超时时间（秒）"
                                                                             Style="{StaticResource SettingsTextBoxStyle}" />
                                                                    <Button Grid.Column="4"
                                                                            Command="{Binding DataContext.RemoveProjectVerificationCommandCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}"
                                                                            Content="×"
                                                                            Style="{StaticResource IconButtonStyle}"
                                                                            VerticalAlignment="Center" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding ToolOptions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,10"
                                                            Padding="16,14"
                                                            CornerRadius="8"
                                                            Background="#FFFFFF"
                                                            BorderBrush="#E2E8F0"
                                                            BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="148" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      VerticalAlignment="Center"
                                                                      Margin="0,0,14,0" />
                                                            <StackPanel Grid.Column="1">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Name}"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="#1E252E" />
                                                                    <Border Margin="8,0,0,0" Padding="6,2" CornerRadius="6" Background="#EEF5F3" BorderBrush="#D9E9E5" BorderThickness="1">
                                                                        <TextBlock Text="{Binding RiskLabel}" FontSize="11" Foreground="#3E6F68" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Description}"
                                                                           Margin="0,4,0,0"
                                                                           Foreground="#667386"
                                                                           TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <ComboBox Grid.Column="2"
                                                                      ItemsSource="{Binding PermissionModeOptions}"
                                                                      SelectedValue="{Binding PermissionMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      SelectedValuePath="Id"
                                                                      ItemTemplate="{StaticResource SelectionOptionTemplate}"
                                                                      Padding="10,0"
                                                                      VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Project-level tool permission overrides -->
                                        <Border Padding="14"
                                                CornerRadius="8"
                                                Background="#F5F8FA"
                                                BorderBrush="#E1E8EF"
                                                BorderThickness="1"
                                                Margin="0,10,0,14">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="项目工具权限覆盖"
                                                               FontSize="15"
                                                               FontWeight="SemiBold"
                                                               Foreground="#1E252E" />
                                                    <Button Command="{Binding AddProjectToolOverrideCommand}"
                                                            Content="+ 添加"
                                                            Margin="12,0,0,0"
                                                            Padding="8,2"
                                                            Style="{StaticResource SubtleButtonStyle}"
                                                            VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="为当前项目单独设置工具权限，覆盖全局配置。项目设置随项目一起保存。"
                                                           Margin="0,6,0,0"
                                                           Foreground="#667386"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding ProjectToolPermissionOverrides}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,8"
                                                            Padding="14,10"
                                                            CornerRadius="8"
                                                            Background="#FFFFFF"
                                                            BorderBrush="#E2E8F0"
                                                            BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="148" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox Text="{Binding ToolId, UpdateSourceTrigger=PropertyChanged}"
                                                                     VerticalAlignment="Center"
                                                                     Padding="10,4"
                                                                     Style="{StaticResource SettingsTextBoxStyle}" />
                                                            <ComboBox Grid.Column="1"
                                                                      ItemsSource="{Binding PermissionModeOptions}"
                                                                      SelectedValue="{Binding PermissionMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      SelectedValuePath="Id"
                                                                      ItemTemplate="{StaticResource SelectionOptionTemplate}"
                                                                      Padding="10,0"
                                                                      VerticalAlignment="Center" />
                                                            <Button Grid.Column="2"
                                                                    Command="{Binding DataContext.RemoveProjectToolOverrideCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding ToolId}"
                                                                    Content="×"
                                                                    Margin="8,0,0,0"
                                                                    Style="{StaticResource IconButtonStyle}"
                                                                    VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="记忆">
                                <ScrollViewer Style="{StaticResource ModernScrollViewerStyle}"
                                              VerticalAlignment="Stretch"
                                              VerticalScrollBarVisibility="Auto"
                                              PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                                    <StackPanel>
                                        <Border Padding="14"
                                                CornerRadius="8"
                                                Background="#F5F8FA"
                                                BorderBrush="#E1E8EF"
                                                BorderThickness="1"
                                                Margin="0,0,0,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="项目长期记忆"
                                                               FontSize="15"
                                                               FontWeight="SemiBold"
                                                               Foreground="#1E252E" />
                                                    <TextBlock Text="{Binding ProjectMemorySummary}"
                                                               Margin="0,6,12,0"
                                                               Foreground="#667386"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Command="{Binding DeduplicateProjectMemoriesCommand}"
                                                        Content="去重"
                                                        Width="72"
                                                        Height="30"
                                                        Margin="8,0,0,0"
                                                        Style="{StaticResource SubtleButtonStyle}" />
                                                <Button Grid.Column="2"
                                                        Command="{Binding ClearProjectMemoriesCommand}"
                                                        Content="清空"
                                                        Width="72"
                                                        Height="30"
                                                        Margin="8,0,0,0"
                                                        Style="{StaticResource SubtleButtonStyle}" />
                                            </Grid>
                                        </Border>

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox ItemsSource="{Binding ProjectMemoryFilterOptions}"
                                                      SelectedValue="{Binding ProjectMemoryFilterId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectedValuePath="Id"
                                                      DisplayMemberPath="Name"
                                                      Padding="10,0" />
                                            <TextBox Grid.Column="2"
                                                     Text="{Binding ProjectMemorySearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     VerticalContentAlignment="Center"
                                                     Style="{StaticResource SettingsTextBoxStyle}" />
                                        </Grid>

                                        <Border Padding="18"
                                                CornerRadius="8"
                                                Background="#FFFFFF"
                                                BorderBrush="#E2E8F0"
                                                BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasProjectMemories}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="当前筛选下没有记忆。Agent Run 完成后会自动沉淀项目、任务和工具记忆；用户偏好会先进入待确认。"
                                                       Foreground="#748092"
                                                       TextWrapping="Wrap" />
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding ProjectMemories}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,10"
                                                            Padding="14"
                                                            CornerRadius="8"
                                                            Background="#FFFFFF"
                                                            BorderBrush="#E2E8F0"
                                                            BorderThickness="1">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border Padding="7,3"
                                                                        CornerRadius="6"
                                                                        Background="#EEF5F3"
                                                                        BorderBrush="#D9E9E5"
                                                                        BorderThickness="1">
                                                                    <TextBlock Text="{Binding CategoryText}"
                                                                               FontSize="11"
                                                                               Foreground="#3E6F68" />
                                                                </Border>
                                                                <Border Padding="7,3"
                                                                        Margin="8,0,0,0"
                                                                        CornerRadius="6"
                                                                        Background="#F4F6F8"
                                                                        BorderBrush="#E1E6EC"
                                                                        BorderThickness="1">
                                                                    <TextBlock Text="{Binding StateText}"
                                                                               FontSize="11"
                                                                               Foreground="#596473" />
                                                                </Border>
                                                                <TextBlock Text="{Binding CreatedAtText}"
                                                                           Margin="10,2,0,0"
                                                                           FontSize="12"
                                                                           Foreground="#8B96A6" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1"
                                                                        Orientation="Horizontal">
                                                                <Button Command="{Binding DataContext.AcceptProjectMemoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Content="确认"
                                                                        Width="64"
                                                                        Height="28"
                                                                        Margin="0,0,8,0">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsPending}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                                <Button Command="{Binding DataContext.RemoveProjectMemoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Content="删除"
                                                                        Width="64"
                                                                        Height="28"
                                                                        Style="{StaticResource SubtleButtonStyle}" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Row="1"
                                                                       Grid.ColumnSpan="2"
                                                                       Text="{Binding Content}"
                                                                       Margin="0,10,0,0"
                                                                       Foreground="#1E252E"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Grid.Row="2"
                                                                       Grid.ColumnSpan="2"
                                                                       Text="{Binding Source, StringFormat=来源：{0}}"
                                                                       Margin="0,8,0,0"
                                                                       Foreground="#748092"
                                                                       FontSize="12"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Grid.Row="2"
                                                                       Grid.ColumnSpan="2"
                                                                       Text="{Binding MetadataText}"
                                                                       Margin="0,26,0,0"
                                                                       Foreground="#8B96A6"
                                                                       FontSize="12"
                                                                       TextWrapping="Wrap" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- Advanced settings tab -->
                            <TabItem Header="高级">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                                    <StackPanel Margin="2,8">
                                        <!-- Retry count -->
                                        <Border Padding="16,14" CornerRadius="8" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="120" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="LLM 重试次数" FontWeight="SemiBold" Foreground="#1E252E" />
                                                    <TextBlock Text="遇到 429/500 等瞬态错误时的重试次数。范围 0-10。" Margin="0,4,12,0" Foreground="#667386" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBox Grid.Column="1" Text="{Binding RetryMaxAttempts, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Style="{StaticResource SettingsTextBoxStyle}" />
                                            </Grid>
                                        </Border>

                                        <!-- Max output tokens -->
                                        <Border Padding="16,14" CornerRadius="8" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="120" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="最大输出 Token" FontWeight="SemiBold" Foreground="#1E252E" />
                                                    <TextBlock Text="LLM 单次响应最大 token 数。Anthropic 等 provider 使用此值。" Margin="0,4,12,0" Foreground="#667386" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBox Grid.Column="1" Text="{Binding MaxOutputTokens, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Style="{StaticResource SettingsTextBoxStyle}" />
                                            </Grid>
                                        </Border>

                                        <!-- Conversation context ratio -->
                                        <Border Padding="16,14" CornerRadius="8" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="120" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="上下文保留比例" FontWeight="SemiBold" Foreground="#1E252E" />
                                                    <TextBlock Text="为对话保留的模型上下文比例，剩余留给 Agent 工具和系统提示。0.3-1.0。" Margin="0,4,12,0" Foreground="#667386" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBox Grid.Column="1" Text="{Binding ConversationContextRatio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Style="{StaticResource SettingsTextBoxStyle}" />
                                            </Grid>
                                        </Border>

                                        <!-- Tokenizer estimation toggle -->
                                        <Border Padding="16,14" CornerRadius="8" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="精确 Token 估算" FontWeight="SemiBold" Foreground="#1E252E" />
                                                    <TextBlock Text="使用 SharpToken (Tiktoken) 精确计算 token 数。关闭后使用字符数/3.6 粗估。" Margin="0,4,12,0" Foreground="#667386" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" IsChecked="{Binding UseTokenizerEstimation, Mode=TwoWay}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <!-- Audit log max file size -->
                                        <Border Padding="16,14" CornerRadius="8" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="120" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="审计日志轮转大小 (MB)" FontWeight="SemiBold" Foreground="#1E252E" />
                                                    <TextBlock Text="单个审计日志文件超过此大小后自动轮转归档。" Margin="0,4,12,0" Foreground="#667386" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBox Grid.Column="1" Text="{Binding AuditLogMaxFileSizeMB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Style="{StaticResource SettingsTextBoxStyle}" />
                                            </Grid>
                                        </Border>

                                        <!-- Audit log retention days -->
                                        <Border Padding="16,14" CornerRadius="8" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="120" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="审计日志保留天数" FontWeight="SemiBold" Foreground="#1E252E" />
                                                    <TextBlock Text="归档的审计日志超过此天数后自动清理。" Margin="0,4,12,0" Foreground="#667386" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBox Grid.Column="1" Text="{Binding AuditLogRetentionDays, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Style="{StaticResource SettingsTextBoxStyle}" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>

                        <DockPanel Grid.Row="2">
                            <TextBlock Text="添加后可在对话输入框右下角直接切换模型。"
                                       Foreground="#8B96A6"
                                       VerticalAlignment="Center" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Command="{Binding CloseSettingsCommand}" Content="取消" Width="88" Height="38" Margin="0,0,10,0" Style="{StaticResource SubtleButtonStyle}" />
                                <Button Command="{Binding SaveSettingsCommand}" Content="保存" Width="96" Height="38" Style="{StaticResource PrimaryButtonStyle}" />
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
