<Window x:Class="AIChat.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AIChat.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding WindowTitle}"
        MinHeight="720"
        MinWidth="1120"
        Height="820"
        Width="1280"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#EEF1F4"
        Loaded="Window_Loaded">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="7"
                            CornerRadius="8"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/ProviderTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

        <DataTemplate x:Key="CallDetailListTemplate">
            <Border Padding="10,8" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#1E252E" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" Margin="0,4,0,0" FontSize="12" Foreground="#748092" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ToolTraceTemplate">
            <Border x:Name="TraceCard"
                    Margin="0,0,0,8"
                    Padding="10"
                    CornerRadius="8"
                    Background="#F7FAFC"
                    BorderBrush="#DDE6EE"
                    BorderThickness="1">
                <Expander IsExpanded="False">
                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="7" Height="7" CornerRadius="4" Background="#2B7A72" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding ToolName}" FontWeight="SemiBold" Foreground="#1E252E" />
                                <TextBlock Text=" · " Foreground="#8A96A5" />
                                <TextBlock Text="{Binding StatusText}" Foreground="#596473" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DurationText}"
                                       Foreground="#98A2B0"
                                       FontSize="12"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="2"
                                    Content="&#xE8C8;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="12"
                                    Width="22" Height="22"
                                    Margin="6,0,0,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#98A2B0"
                                    Cursor="Hand"
                                    ToolTip="复制调用详情"
                                    Command="{Binding DataContext.CopyTraceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </Expander.Header>
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="参数" FontSize="12" FontWeight="SemiBold" Foreground="#596473" />
                        <Border Margin="0,5,0,8" Padding="8" CornerRadius="6" Background="#FFFFFF" BorderBrush="#E4EAF0" BorderThickness="1">
                            <TextBlock Text="{Binding ArgumentsPreview}"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       Foreground="#2A3340"
                                       TextWrapping="Wrap" />
                        </Border>
                        <StackPanel x:Name="ResultPanel">
                            <TextBlock Text="结果" FontSize="12" FontWeight="SemiBold" Foreground="#596473" />
                            <Grid x:Name="ShellResultGrid" Margin="0,5,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Padding="8" CornerRadius="6" Background="#FFFFFF" BorderBrush="#E4EAF0" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ShellText, StringFormat=Shell: {0}}"
                                                   Foreground="#596473"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ExitCodeText, StringFormat=Exit: {0}}"
                                                   Foreground="#596473"
                                                   FontSize="12"
                                                   Margin="12,0,0,0" />
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" x:Name="CommandPanel" Margin="0,6,0,0" Padding="8" CornerRadius="6" Background="#FFFFFF" BorderBrush="#E4EAF0" BorderThickness="1">
                                    <TextBlock Text="{Binding CommandText}"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               Foreground="#2A3340"
                                               TextWrapping="Wrap" />
                                </Border>
                                <Border Grid.Row="2" x:Name="StdoutPanel" Margin="0,6,0,0" Padding="8" CornerRadius="6" Background="#FFFFFF" BorderBrush="#D9E8E4" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="stdout" FontSize="11" FontWeight="SemiBold" Foreground="#2B7A72" />
                                        <TextBlock Text="{Binding StdoutPreview}"
                                                   Margin="0,4,0,0"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   Foreground="#20322F"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="3" x:Name="StderrPanel" Margin="0,6,0,0" Padding="8" CornerRadius="6" Background="#FFF8F7" BorderBrush="#F0C7C2" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="stderr" FontSize="11" FontWeight="SemiBold" Foreground="#9D2F25" />
                                        <TextBlock Text="{Binding StderrPreview}"
                                                   Margin="0,4,0,0"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   Foreground="#5F342F"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border x:Name="RawResultPanel" Margin="0,5,0,0" Padding="8" CornerRadius="6" Background="#FFFFFF" BorderBrush="#E4EAF0" BorderThickness="1">
                                <TextBlock Text="{Binding ResultPreview}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           Foreground="#2A3340"
                                           TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasResult}" Value="False">
                    <Setter TargetName="ResultPanel" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasShell}" Value="True">
                    <Setter TargetName="RawResultPanel" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasShell}" Value="False">
                    <Setter TargetName="ShellResultGrid" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasCommand}" Value="False">
                    <Setter TargetName="CommandPanel" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasStdout}" Value="False">
                    <Setter TargetName="StdoutPanel" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasStderr}" Value="False">
                    <Setter TargetName="StderrPanel" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter TargetName="TraceCard" Property="Background" Value="#FFF8F7" />
                    <Setter TargetName="TraceCard" Property="BorderBrush" Value="#F0C7C2" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="AgentStepTemplate">
            <Border Margin="0,0,0,6"
                    Padding="9,7"
                    CornerRadius="7"
                    Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="StepDot"
                            Width="7"
                            Height="7"
                            CornerRadius="4"
                            Background="#2B7A72"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#1E252E"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}"
                                   Margin="0,2,0,0"
                                   FontSize="11"
                                   Foreground="#748092"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0">
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="11"
                                   Foreground="#596473" />
                        <TextBlock Text="{Binding DurationText}"
                                   Margin="8,0,0,0"
                                   FontSize="11"
                                   Foreground="#98A2B0" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter TargetName="StepDot" Property="Background" Value="#B64034" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="DiffLineTemplate">
            <Border x:Name="DiffLine"
                    Padding="4,1"
                    Background="Transparent">
                <TextBlock Text="{Binding Text}"
                           FontFamily="Consolas"
                           FontSize="11"
                           Foreground="#2A3340"
                           TextWrapping="NoWrap" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Added">
                    <Setter TargetName="DiffLine" Property="Background" Value="#EAF7EF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Removed">
                    <Setter TargetName="DiffLine" Property="Background" Value="#FFF0EF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Header">
                    <Setter TargetName="DiffLine" Property="Background" Value="#EEF3F8" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="AgentFileChangeTemplate">
            <Border Margin="0,0,0,6"
                    Padding="9,7"
                    CornerRadius="7"
                    Background="#F7FBFA"
                    BorderBrush="#D7E8E4"
                    BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Path}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#1E252E"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ToolName}"
                                       Margin="0,2,0,0"
                                       FontSize="11"
                                       Foreground="#748092"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SizeText}"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="#596473" />
                        <Button Grid.Column="2"
                                Command="{Binding DataContext.OpenAgentFileChangeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Content="打开"
                                Width="48"
                                Height="26"
                                Margin="10,0,0,0"
                                Style="{StaticResource SubtleButtonStyle}" />
                        <Button Grid.Column="3"
                                Command="{Binding DataContext.CopyAgentFilePathCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Content="路径"
                                Width="48"
                                Height="26"
                                Margin="6,0,0,0"
                                Style="{StaticResource SubtleButtonStyle}" />
                    </Grid>
                    <Expander x:Name="DiffExpander"
                              Header="查看 diff"
                              Margin="0,7,0,0"
                              FontSize="11"
                              Foreground="#596473"
                              Visibility="Collapsed">
                        <Border Margin="0,6,0,0"
                                Padding="8"
                                CornerRadius="6"
                                Background="#FFFFFF"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1">
                            <ScrollViewer MaxHeight="180"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                                <StackPanel>
                                    <Button Command="{Binding DataContext.CopyAgentFileDiffCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Content="复制 diff"
                                            Width="76"
                                            Height="26"
                                            HorizontalAlignment="Left"
                                            Margin="0,0,0,7"
                                            Style="{StaticResource SubtleButtonStyle}" />
                                    <ItemsControl ItemsSource="{Binding DiffLines}"
                                                  ItemTemplate="{StaticResource DiffLineTemplate}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Expander>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasDiff}" Value="True">
                    <Setter TargetName="DiffExpander" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A message bubble switches layout/style based on ChatMessageViewModel flags. -->
        <DataTemplate x:Key="MessageTemplate">
            <Grid Margin="0,11">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="Bubble"
                        Grid.Column="0"
                        MaxWidth="660"
                        Padding="17,14"
                        CornerRadius="10"
                        Background="#FFFFFF"
                        BorderBrush="#E6EAF0"
                        BorderThickness="1"
                        HorizontalAlignment="Left"
                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="#B8C8D8" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="复制消息"
                                      Command="{Binding PlacementTarget.Tag.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding}" />
                        </ContextMenu>
                    </Border.ContextMenu>
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Author}" FontWeight="SemiBold" Foreground="#202832" />
                            <TextBlock Text="{Binding TimeText}" Foreground="#98A2B0" FontSize="12" HorizontalAlignment="Right" DockPanel.Dock="Right" />
                        </DockPanel>
                        <Border x:Name="AgentRunPanel"
                                Margin="0,0,0,10"
                                Padding="12"
                                CornerRadius="8"
                                Background="#F5F8FA"
                                BorderBrush="#E1E8EF"
                                BorderThickness="1"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="{Binding AgentRunStatusText}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#2A3340" />
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding AgentRunOutcomeText}"
                                                   Margin="12,0,0,0"
                                                   FontSize="11"
                                                   Foreground="#667386"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding AgentRunFileChangeSummaryText}"
                                               Margin="0,7,0,0"
                                               FontSize="11"
                                               Foreground="#42505F"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding AgentRunVerificationSummaryText}"
                                               Margin="0,4,0,0"
                                               FontSize="11"
                                               Foreground="#42505F"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="AgentNoRiskText"
                                               Text="{Binding AgentRunRiskSummaryText}"
                                               Margin="0,4,0,0"
                                               FontSize="11"
                                               Foreground="#42505F"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="AgentRiskText"
                                               Text="{Binding AgentRunRiskSummaryText}"
                                               Margin="0,4,0,0"
                                               FontSize="11"
                                               Foreground="#9D2F25"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="Collapsed" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Command="{Binding DataContext.OpenAgentRunDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Content="详情"
                                        Width="54"
                                        Height="28"
                                        Margin="14,0,0,0"
                                        VerticalAlignment="Top"
                                        Style="{StaticResource SubtleButtonStyle}" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="StreamingText"
                                   Text="{Binding Content}"
                                   Foreground="#2A3340"
                                   FontSize="14"
                                   LineHeight="23"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                        <Border x:Name="ErrorCard"
                                Padding="12"
                                CornerRadius="8"
                                Background="#FFF4F3"
                                BorderBrush="#F0C7C2"
                                BorderThickness="1"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="请求失败" FontWeight="SemiBold" Foreground="#9D2F25" />
                                <TextBlock Text="{Binding Content}"
                                           Margin="0,6,0,0"
                                           Foreground="#5F342F"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <controls:MarkdownBlock x:Name="RenderedMarkdown"
                                                Text="{Binding Content}"
                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                            <controls:MarkdownBlock.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="复制消息"
                                              Command="{Binding PlacementTarget.Tag.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                </ContextMenu>
                            </controls:MarkdownBlock.ContextMenu>
                        </controls:MarkdownBlock>
                    </StackPanel>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsUser}" Value="True">
                    <Setter TargetName="Bubble" Property="Grid.Column" Value="1" />
                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                    <Setter TargetName="Bubble" Property="Background" Value="#EAF5F2" />
                    <Setter TargetName="Bubble" Property="BorderBrush" Value="#CBE5DE" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasAgentRun}" Value="True">
                    <Setter TargetName="AgentRunPanel" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasAgentRisk}" Value="True">
                    <Setter TargetName="AgentRiskText" Property="Visibility" Value="Visible" />
                    <Setter TargetName="AgentNoRiskText" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsAssistant}" Value="True" />
                        <Condition Binding="{Binding IsStreaming}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="StreamingText" Property="Visibility" Value="Visible" />
                    <Setter TargetName="RenderedMarkdown" Property="Visibility" Value="Collapsed" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter TargetName="ErrorCard" Property="Visibility" Value="Visible" />
                    <Setter TargetName="StreamingText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="RenderedMarkdown" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Bubble" Property="Background" Value="#FFF8F7" />
                    <Setter TargetName="Bubble" Property="BorderBrush" Value="#F0C7C2" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="0"
            Background="#F7F8FA"
            CornerRadius="10"
            BorderThickness="0"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Border Width="24" Height="24" CornerRadius="7" Background="#256D67">
                        <TextBlock Text="A" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                    </Border>
                    <TextBlock Text="AIChat" Margin="9,0,0,0" FontSize="14" FontWeight="SemiBold" Foreground="#1D2630" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="—" Style="{StaticResource IconButtonStyle}" Width="40" Height="36" FontSize="17" Click="Minimize_Click" ToolTip="最小化" />
                    <Button Content="□" Style="{StaticResource IconButtonStyle}" Width="40" Height="36" FontSize="16" Click="Maximize_Click" ToolTip="最大化" />
                    <Button Content="×" Style="{StaticResource IconButtonStyle}" Width="40" Height="36" FontSize="20" Click="Close_Click" ToolTip="关闭" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="292" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left sidebar: project-scoped conversation list and settings entry. -->
                <Border Grid.Column="0"
                        Margin="12,0,0,12"
                        Background="#EEF1F4"
                        CornerRadius="10"
                        BorderBrush="#CFD9E4"
                        BorderThickness="1.5">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <Button Command="{Binding NewChatCommand}" Height="40" Style="{StaticResource PrimaryButtonStyle}">
                                <DockPanel>
                                    <TextBlock Text="+" FontSize="17" Margin="0,0,8,0" />
                                    <TextBlock Text="新对话" FontWeight="SemiBold" />
                                </DockPanel>
                            </Button>
                            <Border Margin="0,10,0,0"
                                    Background="#FFFFFF"
                                    BorderBrush="#CFD9E4"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Grid>
                                    <TextBox Text="{Binding ConversationSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="30,8,10,8"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Foreground="#1E252E" />
                                    <TextBlock Text="⌕"
                                               Margin="11,0,0,0"
                                               Foreground="#748092"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False" />
                                    <TextBlock Text="搜索对话"
                                               Margin="30,0,0,0"
                                               Foreground="#9AA5B4"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ConversationSearchText}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <DockPanel Grid.Row="1" Margin="4,18,0,9">
                            <TextBlock Text="项目"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#8994A5"
                                       VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding AddProjectCommand}"
                                    Content="+"
                                    Width="22" Height="22"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Padding="0"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTip="添加项目文件夹" />
                        </DockPanel>

                        <ScrollViewer Grid.Row="2"
                                      Style="{StaticResource ModernScrollViewerStyle}"
                                      VerticalScrollBarVisibility="Auto"
                                      PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                            <ItemsControl ItemsSource="{Binding Projects}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,14"
                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <StackPanel.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="移除项目"
                                                              Command="{Binding PlacementTarget.Tag.RemoveProjectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}" />
                                                </ContextMenu>
                                            </StackPanel.ContextMenu>
                                            <Button Command="{Binding DataContext.SelectProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SidebarItemButtonStyle}">
                                                <Border x:Name="ProjectPill" Padding="8,7" CornerRadius="8" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="18" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Width="7" Height="7" Fill="#256D67" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Name}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#202832"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </Border>
                                            </Button>

                                            <ItemsControl ItemsSource="{Binding VisibleConversations}" Margin="12,6,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.SelectConversationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource SidebarItemButtonStyle}"
                                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                                            <Button.ContextMenu>
                                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                                    <MenuItem Header="打开对话"
                                                                              Command="{Binding PlacementTarget.Tag.SelectConversationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                              CommandParameter="{Binding}" />
                                                                    <MenuItem Header="复制标题"
                                                                              Command="{Binding PlacementTarget.Tag.CopyConversationTitleCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                              CommandParameter="{Binding}" />
                                                                    <MenuItem Header="重命名"
                                                                              Command="{Binding PlacementTarget.Tag.RenameConversationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                              CommandParameter="{Binding}" />
                                                                    <MenuItem Header="打开调用详情"
                                                                              Command="{Binding PlacementTarget.Tag.OpenCallDetailsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                              CommandParameter="{Binding}" />
                                                                    <Separator />
                                                                    <MenuItem Header="删除对话"
                                                                              Command="{Binding PlacementTarget.Tag.DeleteConversationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                              CommandParameter="{Binding}" />
                                                                </ContextMenu>
                                                            </Button.ContextMenu>
                                                            <Border x:Name="ConversationPill" Padding="8,7" CornerRadius="8" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="3" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border x:Name="ConversationAccent" Width="3" CornerRadius="2" Background="Transparent" />
                                                                    <StackPanel Grid.Column="1" Margin="9,0,8,0">
                                                                        <TextBlock Text="{Binding Title}" Foreground="#5F6B7C" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding SearchSnippet}"
                                                                                   Margin="0,3,0,0"
                                                                                   Foreground="#256D67"
                                                                                   FontSize="11"
                                                                                   TextTrimming="CharacterEllipsis">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding HasSearchSnippet}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="2" Text="{Binding UpdatedText}" FontSize="11" Foreground="#A0A9B6" />
                                                                </Grid>
                                                            </Border>
                                                        </Button>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="ConversationPill" Property="Background" Value="#FFFFFF" />
                                                                <Setter TargetName="ConversationPill" Property="BorderBrush" Value="#D7E3EC" />
                                                                <Setter TargetName="ConversationAccent" Property="Background" Value="#256D67" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="ProjectPill" Property="Background" Value="#E4F1EE" />
                                                <Setter TargetName="ProjectPill" Property="BorderBrush" Value="#CFE4DF" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Button Grid.Row="3" Command="{Binding OpenSettingsCommand}" Height="39" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left">
                            <DockPanel>
                                <TextBlock Text="⚙" Margin="2,0,10,0" Foreground="#647083" />
                                <TextBlock Text="设置" Foreground="#303A47" />
                            </DockPanel>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="14,0,10,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 模型选择器和运行历史 -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox ItemsSource="{Binding ConfiguredProviders}"
                                      SelectedValue="{Binding SelectedConfiguredProviderId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Id"
                                      ItemTemplate="{StaticResource ConfiguredProviderTemplate}"
                                      Width="150"
                                      Padding="8,0"
                                      Margin="0,0,6,0"
                                      ToolTip="选择模型提供商" />
                            <ComboBox ItemsSource="{Binding ActiveModelOptions}"
                                      SelectedValue="{Binding SelectedActiveModelId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Id"
                                      ItemTemplate="{StaticResource ModelOptionTemplate}"
                                      Width="130"
                                      Padding="8,0"
                                      ToolTip="选择模型" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding OpenAgentRunHistoryCommand}"
                                Content="运行历史"
                                Width="100"
                                Height="34"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>

                    <Border Grid.Row="0"
                            Margin="290,42,0,0"
                            Padding="12"
                            Background="#F8FAFC"
                            BorderBrush="#D8E2EA"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentProjectHealthText}"
                                       Foreground="#1E252E"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding CurrentProjectProfileText}"
                                       Margin="0,4,0,0"
                                       Foreground="#596473"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding CurrentProjectActivityText}"
                                       Margin="0,3,0,0"
                                       Foreground="#596473"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding CurrentProjectRecommendationText}"
                                       Margin="0,3,0,0"
                                       Foreground="#748092"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                            <WrapPanel Margin="0,8,0,0">
                                <Button Command="{Binding ProjectNextActionCommand}"
                                        Content="{Binding ProjectNextActionText}"
                                        Width="82"
                                        Height="28"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                <Button Command="{Binding RefreshProjectSnapshotCommand}"
                                        Content="刷新"
                                        Width="64"
                                        Height="28"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource SubtleButtonStyle}" />
                                <Button Command="{Binding GenerateProjectAgentsCommand}"
                                        Content="补 AGENTS"
                                        Width="86"
                                        Height="28"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource SubtleButtonStyle}" />
                                <Button Command="{Binding InferProjectVerificationCommandsCommand}"
                                        Content="推断验证"
                                        Width="86"
                                        Height="28"
                                        Style="{StaticResource SubtleButtonStyle}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Margin="0,0,0,8" Background="#FFFFFF" CornerRadius="10" BorderBrush="#CFD9E4" BorderThickness="1.5">
                        <Grid>
                            <ScrollViewer x:Name="MessagesScrollViewer"
                                          Style="{StaticResource ModernScrollViewerStyle}"
                                          Padding="30,20"
                                          VerticalScrollBarVisibility="Auto"
                                          Background="Transparent"
                                          PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
                                          ScrollChanged="MessagesScrollViewer_ScrollChanged">
                                <ItemsControl ItemsSource="{Binding Messages}" ItemTemplate="{StaticResource MessageTemplate}" />
                            </ScrollViewer>
                            <StackPanel Width="380"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasMessages}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Width="42" Height="42" CornerRadius="8" Background="#E8F2F0" HorizontalAlignment="Center">
                                    <TextBlock Text="A" Foreground="#256D67" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="开始一次项目对话"
                                           Margin="0,14,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#1E252E" />
                                <TextBlock Text="输入问题后发送，AIChat 会保留当前项目下的会话历史。"
                                           Margin="0,8,0,0"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Foreground="#748092" />
                            </StackPanel>
                            <Border Width="620"
                                    MaxHeight="500"
                                    Padding="18"
                                    Background="#FFFFFF"
                                    BorderBrush="#D8E2EA"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPendingToolApproval}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid DataContext="{Binding PendingToolApproval}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="确认执行" FontSize="18" FontWeight="SemiBold" Foreground="#1E252E" />
                                            <TextBlock Text="{Binding Summary}" Margin="0,5,0,0" Foreground="#667386" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border DockPanel.Dock="Right" Padding="10,5" CornerRadius="7" Background="#F3F7F8" BorderBrush="#DDE7EA" BorderThickness="1">
                                            <TextBlock Text="{Binding ToolName}" Foreground="#285F5A" FontWeight="SemiBold" FontSize="12" />
                                        </Border>
                                    </DockPanel>
                                    <ScrollViewer Grid.Row="1" Style="{StaticResource ModernScrollViewerStyle}" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                                        <StackPanel>
                                            <TextBlock Text="参数" FontSize="12" FontWeight="SemiBold" Foreground="#596473" />
                                            <Border Margin="0,5,0,10" Padding="10" CornerRadius="6" Background="#F8FAFC" BorderBrush="#E4EAF0" BorderThickness="1">
                                                <TextBlock Text="{Binding ArgumentsJson}" FontFamily="Consolas" FontSize="12" Foreground="#2A3340" TextWrapping="Wrap" />
                                            </Border>
                                            <TextBlock Text="预览" FontSize="12" FontWeight="SemiBold" Foreground="#596473" />
                                            <Border Margin="0,5,0,10" Padding="10" CornerRadius="6" Background="#F8FAFC" BorderBrush="#E4EAF0" BorderThickness="1">
                                                <TextBlock Text="{Binding PreviewText}" FontFamily="Consolas" FontSize="12" Foreground="#2A3340" TextWrapping="Wrap" />
                                            </Border>
                                            <StackPanel>
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasDiff}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="Diff" FontSize="12" FontWeight="SemiBold" Foreground="#596473" />
                                                <Border Margin="0,5,0,0" Padding="10" CornerRadius="6" Background="#FFFCF5" BorderBrush="#E9D8A6" BorderThickness="1">
                                                    <TextBlock Text="{Binding DiffText}" FontFamily="Consolas" FontSize="12" Foreground="#2A3340" TextWrapping="Wrap" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                    <StackPanel Grid.Row="2" Margin="0,14,0,0" Orientation="Horizontal" HorizontalAlignment="Right" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <Button Command="{Binding RejectToolCommand}" Content="拒绝" Width="82" Height="36" Margin="0,0,8,0" Style="{StaticResource SubtleButtonStyle}" />
                                        <Button Command="{Binding ApproveToolForSessionCommand}" Content="本会话允许" Width="112" Height="36" Margin="0,0,8,0" Style="{StaticResource SubtleButtonStyle}" />
                                        <Button Command="{Binding ApproveToolCommand}" Content="允许本次" Width="96" Height="36" Style="{StaticResource PrimaryButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Background="#FFFFFF"
                            BorderBrush="#C8D5E0"
                            BorderThickness="1.5"
                            CornerRadius="10">
                        <Grid Margin="15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Agent status bar: shows live phase/tool/budget info during runs. -->
                            <Border Grid.Row="0"
                                    Margin="0,0,0,8"
                                    Padding="10,6"
                                    CornerRadius="6"
                                    Background="#F0F5FF"
                                    BorderBrush="#C5D8F0"
                                    BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAgentStatus}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding AgentStatusPhase}"
                                               FontWeight="SemiBold"
                                               Foreground="#2D5DAE"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding AgentStatusTool, StringFormat=' · 工具：{0}'}"
                                               Foreground="#5A7AB5"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="4,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AgentStatusTool}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding AgentStatusBudget, StringFormat=' · {0}'}"
                                               Foreground="#5A7AB5"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="4,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AgentStatusBudget}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Composer is bound to DraftMessage; Ctrl+Enter is handled in code-behind. -->
                            <TextBox x:Name="ComposerBox"
                                     Grid.Row="1"
                                     Text="{Binding DraftMessage, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="14"
                                     Foreground="#1E252E"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     KeyDown="ComposerBox_KeyDown" />

                            <TextBlock Text="向 AIChat 提问，或 Ctrl+V 粘贴截图"
                                       Foreground="#A6AFBA"
                                       IsHitTestVisible="False"
                                       Margin="4,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=ComposerBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Row="2"
                                       Text="Ctrl+Enter 发送 · Ctrl+V 粘贴截图 · Enter 换行"
                                       Foreground="#9AA5B4"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False" />

                            <Border Grid.Row="3"
                                    Margin="0,8,0,0"
                                    Padding="8"
                                    CornerRadius="8"
                                    Background="#F7FAFC"
                                    BorderBrush="#E1E8EF"
                                    BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasCurrentInputArtifacts}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <ItemsControl ItemsSource="{Binding CurrentInputArtifacts}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,8,8"
                                                    Padding="8,6"
                                                    CornerRadius="8"
                                                    Background="#FFFFFF"
                                                    BorderBrush="#DDE6EE"
                                                    BorderThickness="1"
                                                    MaxWidth="260"
                                                    ToolTip="{Binding DetailPreview}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <Button x:Name="PreviewImageButton"
                                                                Command="{Binding DataContext.OpenInputArtifactPreviewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Padding="0"
                                                                BorderThickness="0"
                                                                Background="Transparent"
                                                                Visibility="Collapsed"
                                                                ToolTip="查看图片">
                                                            <Border Height="86"
                                                                    Width="168"
                                                                    Margin="0,0,0,6"
                                                                    CornerRadius="6"
                                                                    Background="#EEF3F8"
                                                                    ClipToBounds="True">
                                                                <Image Source="{Binding PreviewImagePath}"
                                                                       Stretch="UniformToFill"
                                                                       SnapsToDevicePixels="True" />
                                                            </Border>
                                                        </Button>
                                                        <TextBlock Text="{Binding FileName}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#1E252E"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Subtitle}"
                                                                   Margin="0,2,0,0"
                                                                   FontSize="11"
                                                                   Foreground="#748092"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <Border x:Name="DeliveryBadge"
                                                                Margin="0,6,0,0"
                                                                Padding="7,3"
                                                                CornerRadius="6"
                                                                Background="#E6F4EF"
                                                                BorderBrush="#CBE6DC"
                                                                BorderThickness="1"
                                                                HorizontalAlignment="Left"
                                                                Visibility="Collapsed">
                                                            <TextBlock Text="{Binding DeliveryBadgeText}"
                                                                       Foreground="#256D67"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold" />
                                                        </Border>
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Command="{Binding DataContext.RemoveInputArtifactCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Content="×"
                                                            Margin="8,0,0,0"
                                                            Style="{StaticResource IconButtonStyle}"
                                                            ToolTip="移除输入附件"
                                                            VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsImagePreview}" Value="True">
                                                    <Setter TargetName="PreviewImageButton" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasDeliveryBadge}" Value="True">
                                                    <Setter TargetName="DeliveryBadge" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding WillSendToModel}" Value="False">
                                                    <Setter TargetName="DeliveryBadge" Property="Background" Value="#F4F6F8" />
                                                    <Setter TargetName="DeliveryBadge" Property="BorderBrush" Value="#E0E6ED" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <Grid Grid.Row="4" Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="210" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Command="{Binding AttachInputArtifactCommand}"
                                            Content="&#xE723;"
                                            FontFamily="Segoe MDL2 Assets"
                                            Style="{StaticResource IconButtonStyle}"
                                            ToolTip="添加输入附件" />
                                    <Button Content="@" Style="{StaticResource IconButtonStyle}" ToolTip="引用当前项目文件" />
                                    <TextBlock Text="{Binding CurrentInputArtifactSummary}"
                                               Margin="8,0,0,0"
                                               Foreground="#5E6C7A"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Border Margin="8,0,0,0" Padding="10,6" CornerRadius="8" Background="#EEF5F3" BorderBrush="#D9E9E5" BorderThickness="1">
                                        <TextBlock Text="只读模式" Foreground="#3E6F68" FontSize="12" />
                                    </Border>
                                    <Border Margin="8,0,0,0" Padding="10,6" CornerRadius="8" Background="#FFF3E0" BorderBrush="#FFB74D" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasApiKey}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="缺少 API Key" Foreground="#E65100" FontSize="12" />
                                    </Border>
                                    <Border Margin="8,0,0,0" Padding="10,6" CornerRadius="8" Background="#FFF3E0" BorderBrush="#FFB74D" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActiveModelSupportsTools}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="不支持工具" Foreground="#E65100" FontSize="12" />
                                    </Border>
                                    <TextBlock Text="{Binding StatusText}"
                                               Margin="10,0,8,0"
                                               Foreground="#7D8794"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Grid Width="40"
                                          Height="40"
                                          Margin="0,0,10,0"
                                          Background="Transparent"
                                          ToolTipService.InitialShowDelay="250">
                                        <Grid.ToolTip>
                                            <ToolTip>
                                                <StackPanel MinWidth="188">
                                                    <TextBlock Text="背景信息窗口：" Foreground="#667386" />
                                                    <TextBlock Text="{Binding ContextWindowSummary}" Margin="0,4,0,0" Foreground="#1E252E" />
                                                    <TextBlock Text="{Binding ContextTokenSummary}" Margin="0,2,0,0" Foreground="#1E252E" />
                                                    <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Foreground="#1E252E" Text="{Binding ContextCompressionHint}" />
                                                </StackPanel>
                                            </ToolTip>
                                        </Grid.ToolTip>
                                        <controls:ContextRing Progress="{Binding ContextPercent}" IsHitTestVisible="False" />
                                        <TextBlock Text="{Binding ContextLabel}" FontSize="10" FontWeight="SemiBold" Foreground="#256D67" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                                    </Grid>
                                    <Button Command="{Binding StopCommand}" Content="{Binding StopButtonText}" Margin="0,0,8,0" Style="{StaticResource SubtleButtonStyle}" />
                                    <Button Command="{Binding SendCommand}" Width="42" Height="38" Padding="0" Style="{StaticResource PrimaryButtonStyle}">
                                        <TextBlock Text="↑" FontSize="18" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid Grid.RowSpan="2" Background="#B8EEF1F4">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRemoveProjectConfirmationOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Border Width="480"
                        MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                        Margin="24"
                        Padding="22"
                        Background="#FFFFFF"
                        CornerRadius="10"
                        BorderBrush="#DCE3EC"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="移除项目"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="#1E252E" />
                            <TextBlock Text="项目文件不会被删除，只会从左侧列表中移除。"
                                       Margin="0,6,0,0"
                                       Foreground="#667386"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Grid.Row="1"
                                Margin="0,18,0,0"
                                Padding="12"
                                CornerRadius="8"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding ProjectRemovalName}"
                                           FontWeight="SemiBold"
                                           Foreground="#2A3340"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ProjectRemovalPathText}"
                                           Margin="0,4,0,0"
                                           Foreground="#748092"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Row="2"
                                    Margin="0,20,0,0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Command="{Binding CancelRemoveProjectCommand}"
                                    Content="取消"
                                    Width="82"
                                    Height="36"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource SubtleButtonStyle}" />
                            <Button Command="{Binding ConfirmRemoveProjectCommand}"
                                    Content="移除"
                                    Width="82"
                                    Height="36"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.RowSpan="2" Background="#B8EEF1F4">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAgentRunHistoryOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Border Width="960"
                        Height="660"
                        MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                        MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                        Margin="24"
                        Padding="22"
                        Background="#FFFFFF"
                        CornerRadius="10"
                        BorderBrush="#DCE3EC"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Margin="0,0,0,18">
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding CloseAgentRunHistoryCommand}"
                                    Content="×"
                                    Style="{StaticResource IconButtonStyle}"
                                    HorizontalAlignment="Right" FontSize="20" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="{Binding AgentRunHistoryTitle}"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Foreground="#1E252E" />
                                    <TextBlock Text="{Binding AgentRunHistorySummary}"
                                               Margin="0,6,0,0"
                                               Foreground="#748092" />
                                    <TextBlock Text="{Binding AgentRunHistoryPerformanceSummary}"
                                               Margin="0,6,0,0"
                                               Foreground="#536172"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding AgentRunHistoryInsight}"
                                               Margin="0,6,0,0"
                                               Foreground="#596473"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox ItemsSource="{Binding AgentRunHistoryFilterOptions}"
                                          SelectedValue="{Binding AgentRunHistoryFilterId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          Width="130"
                                          Height="34"
                                          Margin="12,0,0,0"
                                          VerticalAlignment="Bottom" />
                            </StackPanel>
                        </DockPanel>

                        <Border Grid.Row="1"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="8"
                                Background="#F8FAFC">
                            <Grid>
                                <ScrollViewer Style="{StaticResource ModernScrollViewerStyle}" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                                <ListBox ItemsSource="{Binding AgentRunHistory}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="8,8,8,0"
                                                    Padding="12"
                                                    CornerRadius="8"
                                                    Background="#FFFFFF"
                                                    BorderBrush="#E1E8EF"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <TextBlock Text="{Binding ConversationTitle}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#1E252E"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock DockPanel.Dock="Right"
                                                                       Text="{Binding StatusText}"
                                                                       Margin="12,0,0,0"
                                                                       FontSize="11"
                                                                       Foreground="#3E6F68" />
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding ShortGoal}"
                                                                   Margin="0,5,0,0"
                                                                   Foreground="#596473"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Summary}"
                                                                   Margin="0,5,0,0"
                                                                   FontSize="11"
                                                                   Foreground="#98A2B0"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding AcceptanceSummary}"
                                                                   Margin="0,4,0,0"
                                                                   FontSize="11"
                                                                   Foreground="#6B7280"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Command="{Binding DataContext.SelectAgentRunHistoryItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Content="详情"
                                                            Width="54"
                                                            Height="30"
                                                            Margin="14,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource SubtleButtonStyle}" />
                                                    <Button Grid.Column="2"
                                                            Command="{Binding DataContext.ContinueAgentRunCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Content="继续任务"
                                                            Width="72"
                                                            Height="30"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource PrimaryButtonStyle}" />
                                                    <Button Grid.Column="3"
                                                            Command="{Binding DataContext.RetryAgentRunCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Content="重来"
                                                            Width="54"
                                                            Height="30"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource SubtleButtonStyle}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                </ScrollViewer>
                                <TextBlock Text="暂无 Agent 运行记录"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="#98A2B0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasAgentRunHistory}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.RowSpan="2" Background="#B8EEF1F4">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAgentRunDetailsOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Border Width="960"
                        Height="660"
                        MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                        MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                        Margin="24"
                        Padding="22"
                        Background="#FFFFFF"
                        CornerRadius="10"
                        BorderBrush="#DCE3EC"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid DataContext="{Binding SelectedAgentRunDetails}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="{Binding DataContext.AgentRunDetailsTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="#1E252E" />
                                <TextBlock Text="{Binding Summary}"
                                           Margin="0,6,0,0"
                                           Foreground="#748092" />
                            </StackPanel>
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding DataContext.CloseAgentRunDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Content="×"
                                    Style="{StaticResource IconButtonStyle}"
                                    HorizontalAlignment="Right" />
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding DataContext.CopySelectedAgentRunSummaryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Content="复制摘要"
                                    Width="88"
                                    Height="34"
                                    Margin="0,0,10,0"
                                    Style="{StaticResource SubtleButtonStyle}" />
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding DataContext.CopySelectedAgentRunReviewPacketCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Content="复制复盘"
                                    Width="88"
                                    Height="34"
                                    Margin="0,0,10,0"
                                    Style="{StaticResource SubtleButtonStyle}" />
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding DataContext.AcceptSelectedAgentRunCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Content="验收通过"
                                    Width="88"
                                    Height="34"
                                    Margin="0,0,10,0"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding DataContext.RequestChangesSelectedAgentRunCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Content="需要修改"
                                    Width="88"
                                    Height="34"
                                    Margin="0,0,10,0"
                                    Style="{StaticResource SubtleButtonStyle}" />
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding DataContext.ContinueSelectedAgentRunCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Content="继续任务"
                                    Width="86"
                                    Height="34"
                                    Margin="0,0,10,0"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding DataContext.RetrySelectedAgentRunCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Content="重来"
                                    Width="64"
                                    Height="34"
                                    Margin="0,0,10,0"
                                    Style="{StaticResource SubtleButtonStyle}" />
                        </DockPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TabControl Grid.Column="0" Padding="0" x:Name="LeftTabControl" SelectionChanged="LeftTabControl_SelectionChanged">
                                <TabItem Header="总览">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                                        <StackPanel Margin="4">
                                <Border Padding="14"
                                        CornerRadius="8"
                                        Background="#F8FAFC"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="目标"
                                                   FontWeight="SemiBold"
                                                   Foreground="#303A47" />
                                        <TextBox Text="{Binding Goal, Mode=OneWay}"
                                                 Style="{StaticResource SelectableTextBoxStyle}"
                                                 Margin="0,7,0,0" />
                                        <TextBlock Text="开始时间"
                                                   Margin="0,14,0,0"
                                                   FontWeight="SemiBold"
                                                   Foreground="#303A47" />
                                        <TextBox Text="{Binding StartedText, Mode=OneWay}"
                                                 Style="{StaticResource SelectableTextBoxStyle}"
                                                 Margin="0,5,0,0" />
                                        <TextBlock Text="运行环境"
                                                   Margin="0,14,0,0"
                                                   FontWeight="SemiBold"
                                                   Foreground="#303A47" />
                                        <TextBox Text="{Binding Model, StringFormat=模型：{0}, Mode=OneWay}"
                                                 Style="{StaticResource SelectableTextBoxStyle}"
                                                 Margin="0,5,0,0" />
                                        <TextBox Text="{Binding ProjectPath, StringFormat=项目：{0}, Mode=OneWay}"
                                                 Style="{StaticResource SelectableTextBoxStyle}"
                                                 Margin="0,3,0,0" />
                                        <TextBox Text="{Binding EnabledToolsText, StringFormat=工具：{0}, Mode=OneWay}"
                                                 Style="{StaticResource SelectableTextBoxStyle}"
                                                 Margin="0,3,0,0" />
                                        <TextBox Text="{Binding BudgetText, StringFormat=预算：{0}, Mode=OneWay}"
                                                 Style="{StaticResource SelectableTextBoxStyle}"
                                                 Margin="0,3,0,0" />
                                        <TextBox Text="{Binding MutationGuardrailText, StringFormat=修改记录：{0}, Mode=OneWay}"
                                                 Style="{StaticResource SelectableTextBoxStyle}"
                                                 Margin="0,3,0,0" />
                                        <TextBox Text="{Binding ApprovalSummary, StringFormat=审批：{0}, Mode=OneWay}"
                                                 Style="{StaticResource SelectableTextBoxStyle}"
                                                 Margin="0,3,0,0" />
                                        <TextBox Text="{Binding WorkspaceSnapshotText, StringFormat=工作区：{0}, Mode=OneWay}"
                                                 Style="{StaticResource SelectableTextBoxStyle}"
                                                 Margin="0,3,0,0" />
                                        <TextBlock Text="执行指标"
                                                   Margin="0,14,0,0"
                                                   FontWeight="SemiBold"
                                                   Foreground="#303A47" />
                                        <TextBox Text="{Binding MetricsSummary, Mode=OneWay}"
                                                 Style="{StaticResource SelectableTextBoxStyle}"
                                                 Margin="0,5,0,0" />
                                        <TextBlock Text="质量与策略"
                                                   Margin="0,14,0,0"
                                                   FontWeight="SemiBold"
                                                   Foreground="#303A47" />
                                        <TextBox Text="{Binding QualityScoreText, StringFormat=评分：{0}, Mode=OneWay}"
                                                 Style="{StaticResource SelectableTextBoxStyle}"
                                                 Margin="0,5,0,0" />
                                        <TextBox Text="{Binding QualitySummary, StringFormat=摘要：{0}, Mode=OneWay}"
                                                 Style="{StaticResource SelectableTextBoxStyle}"
                                                 Margin="0,3,0,0" />
                                        <TextBox Text="{Binding StrategySuggestion, StringFormat=策略：{0}, Mode=OneWay}"
                                                 Style="{StaticResource SelectableTextBoxStyle}"
                                                 Margin="0,3,0,0" />
                                        <TextBox Text="{Binding ExecutionPolicySummary, StringFormat=原因：{0}, Mode=OneWay}"
                                                 Style="{StaticResource SelectableTextBoxStyle}"
                                                 Margin="0,3,0,0" />
                                        <StackPanel Margin="0,14,0,0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasSmokeTests}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="验收清单"
                                                       FontWeight="SemiBold"
                                                       Foreground="#303A47" />
                                            <TextBox Text="{Binding SmokeTestSummary, Mode=OneWay}"
                                                     Style="{StaticResource SelectableTextBoxStyle}"
                                                     Margin="0,5,0,0" />
                                            <TextBox Text="{Binding AcceptanceStatusText, StringFormat=用户验收：{0}, Mode=OneWay}"
                                                     Style="{StaticResource SelectableTextBoxStyle}"
                                                     Margin="0,3,0,0" />
                                            <TextBox Text="{Binding AcceptanceNote, StringFormat=备注：{0}, Mode=OneWay}"
                                                     Style="{StaticResource SelectableTextBoxStyle}"
                                                     Margin="0,3,0,0" />
                                            <ItemsControl ItemsSource="{Binding SmokeTests}"
                                                          Margin="0,8,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="9"
                                                                Margin="0,0,0,7"
                                                                CornerRadius="6"
                                                                Background="#FFFFFF"
                                                                BorderBrush="#E2E8F0"
                                                                BorderThickness="1">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                          VerticalAlignment="Top"
                                                                          Margin="0,2,8,0" />
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock Text="{Binding Title}"
                                                                               Foreground="#1F2937"
                                                                               FontWeight="SemiBold"
                                                                               TextWrapping="Wrap" />
                                                                    <TextBlock Text="{Binding Detail}"
                                                                               Margin="0,3,0,0"
                                                                               Foreground="#667386"
                                                                               TextWrapping="Wrap" />
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="2"
                                                                           Text="{Binding StatusText}"
                                                                           Foreground="#536172"
                                                                           FontSize="11"
                                                                           Margin="10,1,0,0" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <TextBlock Text="当前阶段"
                                                   Margin="0,14,0,0"
                                                   FontWeight="SemiBold"
                                                   Foreground="#303A47" />
                                        <TextBox Text="{Binding PhaseText, Mode=OneWay}"
                                                 Style="{StaticResource SelectableTextBoxStyle}"
                                                 Margin="0,5,0,0" />
                                        <TextBox Text="{Binding CurrentPhaseSummary, StringFormat=摘要：{0}, Mode=OneWay}"
                                                 Style="{StaticResource SelectableTextBoxStyle}"
                                                 Margin="0,3,0,0" />
                                        <ItemsControl ItemsSource="{Binding PhaseHistory}"
                                                      Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,0,0,5">
                                                        <TextBlock Text="{Binding PhaseText}"
                                                                   Foreground="#2A3340"
                                                                   FontSize="12" />
                                                        <TextBlock DockPanel.Dock="Right"
                                                                   Text="{Binding StatusText}"
                                                                   Margin="12,0,0,0"
                                                                   Foreground="#748092"
                                                                   FontSize="11" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Margin="0,14,0,0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasContinuation}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="继续运行"
                                                       FontWeight="SemiBold"
                                                       Foreground="#303A47" />
                                            <TextBox Text="{Binding ContinuedFromRunText, Mode=OneWay}"
                                                     Style="{StaticResource SelectableTextBoxStyle}"
                                                     Margin="0,5,0,0" />
                                        </StackPanel>
                                        <StackPanel Margin="0,14,0,0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasRetrySource}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="重试来源"
                                                       FontWeight="SemiBold"
                                                       Foreground="#303A47" />
                                            <TextBox Text="{Binding RetriedFromRunText, Mode=OneWay}"
                                                     Style="{StaticResource SelectableTextBoxStyle}"
                                                     Margin="0,5,0,0" />
                                        </StackPanel>
                                        <StackPanel Margin="0,14,0,0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasCompletionReason}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="结束原因"
                                                       FontWeight="SemiBold"
                                                       Foreground="#303A47" />
                                            <TextBox Text="{Binding CompletionReasonText, Mode=OneWay}"
                                                     Style="{StaticResource SelectableTextBoxStyle}"
                                                     Margin="0,5,0,0" />
                                        </StackPanel>
