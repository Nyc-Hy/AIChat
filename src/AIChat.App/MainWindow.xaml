<Window x:Class="AIChat.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AIChat.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="AIChat"
        MinHeight="720"
        MinWidth="1120"
        Height="820"
        Width="1280"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#EEF1F4"
        Loaded="Window_Loaded">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="7"
                            CornerRadius="8"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Templates translate ViewModel objects into reusable pieces of UI. -->
        <DataTemplate x:Key="ProviderOptionTemplate">
            <TextBlock Text="{Binding Name}"
                       Foreground="#1E252E"
                       TextTrimming="CharacterEllipsis" />
        </DataTemplate>

        <DataTemplate x:Key="ConfiguredProviderTemplate">
            <TextBlock Text="{Binding DisplayName}"
                       Foreground="#1E252E"
                       TextTrimming="CharacterEllipsis" />
        </DataTemplate>

        <DataTemplate x:Key="ModelOptionTemplate">
            <TextBlock Text="{Binding DisplayName}"
                       Foreground="#1E252E"
                       TextTrimming="CharacterEllipsis" />
        </DataTemplate>

        <DataTemplate x:Key="SelectionOptionTemplate">
            <TextBlock Text="{Binding Name}"
                       Foreground="#1E252E"
                       TextTrimming="CharacterEllipsis" />
        </DataTemplate>

        <DataTemplate x:Key="CallDetailListTemplate">
            <Border Padding="10,8" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#1E252E" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" Margin="0,4,0,0" FontSize="12" Foreground="#748092" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ToolTraceTemplate">
            <Border x:Name="TraceCard"
                    Margin="0,0,0,8"
                    Padding="10"
                    CornerRadius="8"
                    Background="#F7FAFC"
                    BorderBrush="#DDE6EE"
                    BorderThickness="1">
                <Expander IsExpanded="False">
                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="7" Height="7" CornerRadius="4" Background="#2B7A72" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding ToolName}" FontWeight="SemiBold" Foreground="#1E252E" />
                                <TextBlock Text=" · " Foreground="#8A96A5" />
                                <TextBlock Text="{Binding StatusText}" Foreground="#596473" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DurationText}"
                                       Foreground="#98A2B0"
                                       FontSize="12"
                                       Margin="12,0,0,0" />
                        </Grid>
                    </Expander.Header>
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="参数" FontSize="12" FontWeight="SemiBold" Foreground="#596473" />
                        <Border Margin="0,5,0,8" Padding="8" CornerRadius="6" Background="#FFFFFF" BorderBrush="#E4EAF0" BorderThickness="1">
                            <TextBlock Text="{Binding ArgumentsPreview}"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       Foreground="#2A3340"
                                       TextWrapping="Wrap" />
                        </Border>
                        <StackPanel x:Name="ResultPanel">
                            <TextBlock Text="结果" FontSize="12" FontWeight="SemiBold" Foreground="#596473" />
                            <Grid x:Name="ShellResultGrid" Margin="0,5,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Padding="8" CornerRadius="6" Background="#FFFFFF" BorderBrush="#E4EAF0" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ShellText, StringFormat=Shell: {0}}"
                                                   Foreground="#596473"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ExitCodeText, StringFormat=Exit: {0}}"
                                                   Foreground="#596473"
                                                   FontSize="12"
                                                   Margin="12,0,0,0" />
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" x:Name="CommandPanel" Margin="0,6,0,0" Padding="8" CornerRadius="6" Background="#FFFFFF" BorderBrush="#E4EAF0" BorderThickness="1">
                                    <TextBlock Text="{Binding CommandText}"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               Foreground="#2A3340"
                                               TextWrapping="Wrap" />
                                </Border>
                                <Border Grid.Row="2" x:Name="StdoutPanel" Margin="0,6,0,0" Padding="8" CornerRadius="6" Background="#FFFFFF" BorderBrush="#D9E8E4" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="stdout" FontSize="11" FontWeight="SemiBold" Foreground="#2B7A72" />
                                        <TextBlock Text="{Binding StdoutPreview}"
                                                   Margin="0,4,0,0"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   Foreground="#20322F"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="3" x:Name="StderrPanel" Margin="0,6,0,0" Padding="8" CornerRadius="6" Background="#FFF8F7" BorderBrush="#F0C7C2" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="stderr" FontSize="11" FontWeight="SemiBold" Foreground="#9D2F25" />
                                        <TextBlock Text="{Binding StderrPreview}"
                                                   Margin="0,4,0,0"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   Foreground="#5F342F"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border x:Name="RawResultPanel" Margin="0,5,0,0" Padding="8" CornerRadius="6" Background="#FFFFFF" BorderBrush="#E4EAF0" BorderThickness="1">
                                <TextBlock Text="{Binding ResultPreview}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           Foreground="#2A3340"
                                           TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasResult}" Value="False">
                    <Setter TargetName="ResultPanel" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasShell}" Value="True">
                    <Setter TargetName="RawResultPanel" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasShell}" Value="False">
                    <Setter TargetName="ShellResultGrid" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasCommand}" Value="False">
                    <Setter TargetName="CommandPanel" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasStdout}" Value="False">
                    <Setter TargetName="StdoutPanel" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasStderr}" Value="False">
                    <Setter TargetName="StderrPanel" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter TargetName="TraceCard" Property="Background" Value="#FFF8F7" />
                    <Setter TargetName="TraceCard" Property="BorderBrush" Value="#F0C7C2" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="AgentStepTemplate">
            <Border Margin="0,0,0,6"
                    Padding="9,7"
                    CornerRadius="7"
                    Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="StepDot"
                            Width="7"
                            Height="7"
                            CornerRadius="4"
                            Background="#2B7A72"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#1E252E"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}"
                                   Margin="0,2,0,0"
                                   FontSize="11"
                                   Foreground="#748092"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0">
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="11"
                                   Foreground="#596473" />
                        <TextBlock Text="{Binding DurationText}"
                                   Margin="8,0,0,0"
                                   FontSize="11"
                                   Foreground="#98A2B0" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter TargetName="StepDot" Property="Background" Value="#B64034" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="AgentFileChangeTemplate">
            <Border Margin="0,0,0,6"
                    Padding="9,7"
                    CornerRadius="7"
                    Background="#F7FBFA"
                    BorderBrush="#D7E8E4"
                    BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Path}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#1E252E"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ToolName}"
                                       Margin="0,2,0,0"
                                       FontSize="11"
                                       Foreground="#748092"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SizeText}"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="#596473" />
                    </Grid>
                    <Expander x:Name="DiffExpander"
                              Header="查看 diff"
                              Margin="0,7,0,0"
                              FontSize="11"
                              Foreground="#596473"
                              Visibility="Collapsed">
                        <Border Margin="0,6,0,0"
                                Padding="8"
                                CornerRadius="6"
                                Background="#FFFFFF"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1">
                            <ScrollViewer MaxHeight="180"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding DiffText}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Foreground="#2A3340"
                                           TextWrapping="NoWrap" />
                            </ScrollViewer>
                        </Border>
                    </Expander>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasDiff}" Value="True">
                    <Setter TargetName="DiffExpander" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A message bubble switches layout/style based on ChatMessageViewModel flags. -->
        <DataTemplate x:Key="MessageTemplate">
            <Grid Margin="0,11">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="Bubble"
                        Grid.Column="0"
                        MaxWidth="660"
                        Padding="17,14"
                        CornerRadius="10"
                        Background="#FFFFFF"
                        BorderBrush="#E6EAF0"
                        BorderThickness="1"
                        HorizontalAlignment="Left"
                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Border.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="复制消息"
                                      Command="{Binding PlacementTarget.Tag.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding}" />
                        </ContextMenu>
                    </Border.ContextMenu>
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Author}" FontWeight="SemiBold" Foreground="#202832" />
                            <TextBlock Text="{Binding TimeText}" Foreground="#98A2B0" FontSize="12" HorizontalAlignment="Right" DockPanel.Dock="Right" />
                        </DockPanel>
                        <Border x:Name="AgentRunPanel"
                                Margin="0,0,0,10"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="执行步骤"
                                           Margin="0,0,0,7"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#667386" />
                                <ItemsControl ItemsSource="{Binding AgentRun.Steps}"
                                              ItemTemplate="{StaticResource AgentStepTemplate}" />
                                <Border x:Name="FileChangePanel"
                                        Margin="0,5,0,0"
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,7">
                                            <TextBlock Text="文件变更"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#667386"
                                                       VerticalAlignment="Center" />
                                            <StackPanel DockPanel.Dock="Right"
                                                        Orientation="Horizontal">
                                                <Button Command="{Binding DataContext.CommitAgentRunChangesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Content="提交本轮"
                                                        Width="78"
                                                        Height="28"
                                                        Margin="0,0,6,0"
                                                        Style="{StaticResource SubtleButtonStyle}" />
                                                <Button Command="{Binding DataContext.RestoreAgentRunChangesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Content="撤销"
                                                        Width="54"
                                                        Height="28"
                                                        Margin="0,0,6,0"
                                                        Style="{StaticResource SubtleButtonStyle}" />
                                                <Button Command="{Binding DataContext.CopyAgentRunChangeSummaryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Content="复制"
                                                        Width="54"
                                                        Height="28"
                                                        Style="{StaticResource SubtleButtonStyle}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding AgentRun.FileChanges}"
                                                      ItemTemplate="{StaticResource AgentFileChangeTemplate}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border x:Name="ToolTracePanel"
                                Margin="0,0,0,10"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="工具调用"
                                           Margin="0,0,0,7"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#667386" />
                                <ItemsControl ItemsSource="{Binding ToolTraces}"
                                              ItemTemplate="{StaticResource ToolTraceTemplate}" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="StreamingText"
                                   Text="{Binding Content}"
                                   Foreground="#2A3340"
                                   FontSize="14"
                                   LineHeight="23"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                        <Border x:Name="ErrorCard"
                                Padding="12"
                                CornerRadius="8"
                                Background="#FFF4F3"
                                BorderBrush="#F0C7C2"
                                BorderThickness="1"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="请求失败" FontWeight="SemiBold" Foreground="#9D2F25" />
                                <TextBlock Text="{Binding Content}"
                                           Margin="0,6,0,0"
                                           Foreground="#5F342F"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <controls:MarkdownBlock x:Name="RenderedMarkdown"
                                                Text="{Binding Content}"
                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                            <controls:MarkdownBlock.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="复制消息"
                                              Command="{Binding PlacementTarget.Tag.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                </ContextMenu>
                            </controls:MarkdownBlock.ContextMenu>
                        </controls:MarkdownBlock>
                    </StackPanel>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsUser}" Value="True">
                    <Setter TargetName="Bubble" Property="Grid.Column" Value="1" />
                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                    <Setter TargetName="Bubble" Property="Background" Value="#EAF5F2" />
                    <Setter TargetName="Bubble" Property="BorderBrush" Value="#CBE5DE" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasToolTraces}" Value="True">
                    <Setter TargetName="ToolTracePanel" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasAgentRun}" Value="True">
                    <Setter TargetName="AgentRunPanel" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding AgentRun.HasFileChanges}" Value="True">
                    <Setter TargetName="FileChangePanel" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsAssistant}" Value="True" />
                        <Condition Binding="{Binding IsStreaming}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="StreamingText" Property="Visibility" Value="Visible" />
                    <Setter TargetName="RenderedMarkdown" Property="Visibility" Value="Collapsed" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter TargetName="ErrorCard" Property="Visibility" Value="Visible" />
                    <Setter TargetName="StreamingText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="RenderedMarkdown" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Bubble" Property="Background" Value="#FFF8F7" />
                    <Setter TargetName="Bubble" Property="BorderBrush" Value="#F0C7C2" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border Margin="0"
            Background="#F7F8FA"
            CornerRadius="10"
            BorderThickness="0"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="292" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="138" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Border Width="24" Height="24" CornerRadius="7" Background="#256D67">
                        <TextBlock Text="A" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                    </Border>
                    <TextBlock Text="AIChat" Margin="9,0,0,0" FontSize="14" FontWeight="SemiBold" Foreground="#1D2630" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <TextBlock Text="{Binding CurrentConversationTitle}"
                               Foreground="#1E252E"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Border Margin="12,0,0,0"
                            Padding="8,3"
                            CornerRadius="8"
                            Background="#EDF4F2"
                            BorderBrush="#D6E7E3"
                            BorderThickness="1">
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="#3E6F68"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="260" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="—" Style="{StaticResource IconButtonStyle}" Width="40" Height="36" FontSize="17" Click="Minimize_Click" ToolTip="最小化" />
                    <Button Content="□" Style="{StaticResource IconButtonStyle}" Width="40" Height="36" FontSize="16" Click="Maximize_Click" ToolTip="最大化" />
                    <Button Content="×" Style="{StaticResource IconButtonStyle}" Width="40" Height="36" FontSize="20" Click="Close_Click" ToolTip="关闭" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="292" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="350" />
                </Grid.ColumnDefinitions>

                <!-- Left sidebar: project-scoped conversation list and settings entry. -->
                <Border Grid.Column="0"
                        Margin="12,0,0,12"
                        Background="#EEF1F4"
                        CornerRadius="10"
                        BorderBrush="#CFD9E4"
                        BorderThickness="1.5">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <Button Command="{Binding NewChatCommand}" Height="40" Style="{StaticResource PrimaryButtonStyle}">
                                <DockPanel>
                                    <TextBlock Text="+" FontSize="17" Margin="0,0,8,0" />
                                    <TextBlock Text="新对话" FontWeight="SemiBold" />
                                </DockPanel>
                            </Button>
                            <Border Margin="0,10,0,0"
                                    Background="#FFFFFF"
                                    BorderBrush="#CFD9E4"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Grid>
                                    <TextBox Text="{Binding ConversationSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="30,8,10,8"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Foreground="#1E252E" />
                                    <TextBlock Text="⌕"
                                               Margin="11,0,0,0"
                                               Foreground="#748092"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False" />
                                    <TextBlock Text="搜索对话"
                                               Margin="30,0,0,0"
                                               Foreground="#9AA5B4"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ConversationSearchText}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <TextBlock Grid.Row="1"
                                   Text="项目"
                                   Margin="4,18,0,9"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#8994A5" />

                        <ScrollViewer Grid.Row="2"
                                      Style="{StaticResource ModernScrollViewerStyle}"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Projects}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,14">
                                            <Button Command="{Binding DataContext.SelectProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SidebarItemButtonStyle}">
                                                <Border x:Name="ProjectPill" Padding="8,7" CornerRadius="8" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="18" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Width="7" Height="7" Fill="#256D67" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Name}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#202832"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </Border>
                                            </Button>

                                            <ItemsControl ItemsSource="{Binding VisibleConversations}" Margin="12,6,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.SelectConversationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource SidebarItemButtonStyle}"
                                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                                            <Button.ContextMenu>
                                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                                    <MenuItem Header="打开对话"
                                                                              Command="{Binding PlacementTarget.Tag.SelectConversationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                              CommandParameter="{Binding}" />
                                                                    <MenuItem Header="复制标题"
                                                                              Command="{Binding PlacementTarget.Tag.CopyConversationTitleCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                              CommandParameter="{Binding}" />
                                                                    <MenuItem Header="重命名"
                                                                              Command="{Binding PlacementTarget.Tag.RenameConversationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                              CommandParameter="{Binding}" />
                                                                    <MenuItem Header="打开调用详情"
                                                                              Command="{Binding PlacementTarget.Tag.OpenCallDetailsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                              CommandParameter="{Binding}" />
                                                                    <Separator />
                                                                    <MenuItem Header="删除对话"
                                                                              Command="{Binding PlacementTarget.Tag.DeleteConversationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                              CommandParameter="{Binding}" />
                                                                </ContextMenu>
                                                            </Button.ContextMenu>
                                                            <Border x:Name="ConversationPill" Padding="8,7" CornerRadius="8" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="3" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border x:Name="ConversationAccent" Width="3" CornerRadius="2" Background="Transparent" />
                                                                    <StackPanel Grid.Column="1" Margin="9,0,8,0">
                                                                        <TextBlock Text="{Binding Title}" Foreground="#5F6B7C" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding SearchSnippet}"
                                                                                   Margin="0,3,0,0"
                                                                                   Foreground="#256D67"
                                                                                   FontSize="11"
                                                                                   TextTrimming="CharacterEllipsis">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding HasSearchSnippet}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="2" Text="{Binding UpdatedText}" FontSize="11" Foreground="#A0A9B6" />
                                                                </Grid>
                                                            </Border>
                                                        </Button>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="ConversationPill" Property="Background" Value="#FFFFFF" />
                                                                <Setter TargetName="ConversationPill" Property="BorderBrush" Value="#D7E3EC" />
                                                                <Setter TargetName="ConversationAccent" Property="Background" Value="#256D67" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="ProjectPill" Property="Background" Value="#E4F1EE" />
                                                <Setter TargetName="ProjectPill" Property="BorderBrush" Value="#CFE4DF" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Button Grid.Row="3" Command="{Binding OpenSettingsCommand}" Height="39" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left">
                            <DockPanel>
                                <TextBlock Text="⚙" Margin="2,0,10,0" Foreground="#647083" />
                                <TextBlock Text="设置" Foreground="#303A47" />
                            </DockPanel>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="14,0,10,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="158" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="0,0,0,12" Background="#FFFFFF" CornerRadius="10" BorderBrush="#CFD9E4" BorderThickness="1.5">
                        <Grid>
                            <!-- Main transcript. Code-behind auto-scrolls this when messages stream. -->
                            <ScrollViewer x:Name="MessagesScrollViewer"
                                          Style="{StaticResource ModernScrollViewerStyle}"
                                          Padding="30,20"
                                          VerticalScrollBarVisibility="Auto"
                                          Background="Transparent">
                                <ItemsControl ItemsSource="{Binding Messages}" ItemTemplate="{StaticResource MessageTemplate}" />
                            </ScrollViewer>
                            <StackPanel Width="380"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasMessages}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Width="42" Height="42" CornerRadius="8" Background="#E8F2F0" HorizontalAlignment="Center">
                                    <TextBlock Text="A" Foreground="#256D67" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="开始一次项目对话"
                                           Margin="0,14,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#1E252E" />
                                <TextBlock Text="输入问题后发送，AIChat 会保留当前项目下的会话历史。"
                                           Margin="0,8,0,0"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Foreground="#748092" />
                            </StackPanel>
                            <Border Width="620"
                                    MaxHeight="500"
                                    Padding="18"
                                    Background="#FFFFFF"
                                    BorderBrush="#D8E2EA"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPendingToolApproval}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid DataContext="{Binding PendingToolApproval}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="确认执行" FontSize="18" FontWeight="SemiBold" Foreground="#1E252E" />
                                            <TextBlock Text="{Binding Summary}" Margin="0,5,0,0" Foreground="#667386" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border DockPanel.Dock="Right" Padding="10,5" CornerRadius="7" Background="#F3F7F8" BorderBrush="#DDE7EA" BorderThickness="1">
                                            <TextBlock Text="{Binding ToolName}" Foreground="#285F5A" FontWeight="SemiBold" FontSize="12" />
                                        </Border>
                                    </DockPanel>
                                    <ScrollViewer Grid.Row="1" Style="{StaticResource ModernScrollViewerStyle}" VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <TextBlock Text="参数" FontSize="12" FontWeight="SemiBold" Foreground="#596473" />
                                            <Border Margin="0,5,0,10" Padding="10" CornerRadius="6" Background="#F8FAFC" BorderBrush="#E4EAF0" BorderThickness="1">
                                                <TextBlock Text="{Binding ArgumentsJson}" FontFamily="Consolas" FontSize="12" Foreground="#2A3340" TextWrapping="Wrap" />
                                            </Border>
                                            <TextBlock Text="预览" FontSize="12" FontWeight="SemiBold" Foreground="#596473" />
                                            <Border Margin="0,5,0,10" Padding="10" CornerRadius="6" Background="#F8FAFC" BorderBrush="#E4EAF0" BorderThickness="1">
                                                <TextBlock Text="{Binding PreviewText}" FontFamily="Consolas" FontSize="12" Foreground="#2A3340" TextWrapping="Wrap" />
                                            </Border>
                                            <StackPanel>
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasDiff}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="Diff" FontSize="12" FontWeight="SemiBold" Foreground="#596473" />
                                                <Border Margin="0,5,0,0" Padding="10" CornerRadius="6" Background="#FFFCF5" BorderBrush="#E9D8A6" BorderThickness="1">
                                                    <TextBlock Text="{Binding DiffText}" FontFamily="Consolas" FontSize="12" Foreground="#2A3340" TextWrapping="Wrap" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                    <StackPanel Grid.Row="2" Margin="0,14,0,0" Orientation="Horizontal" HorizontalAlignment="Right" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <Button Command="{Binding RejectToolCommand}" Content="拒绝" Width="82" Height="36" Margin="0,0,8,0" Style="{StaticResource SubtleButtonStyle}" />
                                        <Button Command="{Binding ApproveToolForSessionCommand}" Content="本会话允许" Width="112" Height="36" Margin="0,0,8,0" Style="{StaticResource SubtleButtonStyle}" />
                                        <Button Command="{Binding ApproveToolCommand}" Content="允许本次" Width="96" Height="36" Style="{StaticResource PrimaryButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Background="#FFFFFF"
                            BorderBrush="#C8D5E0"
                            BorderThickness="1.5"
                            CornerRadius="10">
                        <Grid Margin="15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Composer is bound to DraftMessage; Ctrl+Enter is handled in code-behind. -->
                            <TextBox x:Name="ComposerBox"
                                     Text="{Binding DraftMessage, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="14"
                                     Foreground="#1E252E"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     KeyDown="ComposerBox_KeyDown" />

                            <TextBlock Text="向 AIChat 提问，或 @ 引用当前项目文件"
                                       Foreground="#A6AFBA"
                                       IsHitTestVisible="False"
                                       Margin="4,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=ComposerBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Row="1"
                                       Text="Ctrl+Enter 发送 · Enter 换行"
                                       Foreground="#9AA5B4"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False" />

                            <Grid Grid.Row="2" Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="210" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="＋" Style="{StaticResource IconButtonStyle}" ToolTip="添加文件" />
                                    <Button Content="@" Style="{StaticResource IconButtonStyle}" ToolTip="引用当前项目文件" />
                                    <Border Margin="8,0,0,0" Padding="10,6" CornerRadius="8" Background="#EEF5F3" BorderBrush="#D9E9E5" BorderThickness="1">
                                        <TextBlock Text="只读模式" Foreground="#3E6F68" FontSize="12" />
                                    </Border>
                                    <TextBlock Text="{Binding StatusText}"
                                               Margin="10,0,8,0"
                                               Foreground="#7D8794"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <ComboBox ItemsSource="{Binding ConfiguredProviders}"
                                              SelectedValue="{Binding SelectedConfiguredProviderId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Id"
                                              ItemTemplate="{StaticResource ConfiguredProviderTemplate}"
                                              Width="142"
                                              Padding="10,0"
                                              Margin="0,0,8,0"
                                              ToolTip="选择模型提供商" />
                                    <ComboBox ItemsSource="{Binding ActiveModelOptions}"
                                              SelectedValue="{Binding SelectedActiveModelId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Id"
                                              ItemTemplate="{StaticResource ModelOptionTemplate}"
                                              Width="124"
                                              Padding="10,0"
                                              Margin="0,0,8,0"
                                              ToolTip="选择模型" />
                                    <Grid Width="40"
                                          Height="40"
                                          Margin="0,0,10,0"
                                          Background="Transparent"
                                          ToolTipService.InitialShowDelay="250">
                                        <Grid.ToolTip>
                                            <ToolTip>
                                                <StackPanel MinWidth="188">
                                                    <TextBlock Text="背景信息窗口：" Foreground="#667386" />
                                                    <TextBlock Text="{Binding ContextWindowSummary}" Margin="0,4,0,0" Foreground="#1E252E" />
                                                    <TextBlock Text="{Binding ContextTokenSummary}" Margin="0,2,0,0" Foreground="#1E252E" />
                                                    <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Foreground="#1E252E" Text="{Binding ContextCompressionHint}" />
                                                </StackPanel>
                                            </ToolTip>
                                        </Grid.ToolTip>
                                        <controls:ContextRing Progress="{Binding ContextPercent}" IsHitTestVisible="False" />
                                        <TextBlock Text="{Binding ContextLabel}" FontSize="10" FontWeight="SemiBold" Foreground="#256D67" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                                    </Grid>
                                    <Button Command="{Binding StopCommand}" Content="停止" Margin="0,0,8,0" Style="{StaticResource SubtleButtonStyle}" />
                                    <Button Command="{Binding SendCommand}" Width="42" Height="38" Padding="0" Style="{StaticResource PrimaryButtonStyle}">
                                        <TextBlock Text="↑" FontSize="18" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Column="2"
                        Margin="0,0,12,12"
                        Background="#FFFFFF"
                        CornerRadius="10"
                        BorderBrush="#CFD9E4"
                        BorderThickness="1.5">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="148" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Workspace Changes"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#1E252E" />
                                <TextBlock Text="{Binding WorkspaceStatusText}"
                                           Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="#748092"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right"
                                        Orientation="Horizontal">
                                <Button Command="{Binding CommitWorkspaceFileCommand}"
                                        Content="提交"
                                        Width="62"
                                        Height="32"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                <Button Command="{Binding RestoreWorkspaceFileCommand}"
                                        Content="恢复"
                                        Width="62"
                                        Height="32"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource SubtleButtonStyle}" />
                                <Button Command="{Binding RefreshWorkspaceChangesCommand}"
                                        Content="刷新"
                                        Width="62"
                                        Height="32"
                                        Style="{StaticResource SubtleButtonStyle}" />
                            </StackPanel>
                        </DockPanel>

                        <Border Grid.Row="1"
                                Padding="10"
                                CornerRadius="8"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1">
                            <Grid>
                                <ListBox ItemsSource="{Binding WorkspaceChanges}"
                                         SelectedItem="{Binding SelectedWorkspaceChange, Mode=TwoWay}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2" MinHeight="28">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Padding="5,2"
                                                        CornerRadius="5"
                                                        Background="#EEF5F3"
                                                        BorderBrush="#D9E9E5"
                                                        BorderThickness="1"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayStatus}"
                                                               FontSize="10"
                                                               Foreground="#3E6F68"
                                                               TextAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Border>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Path}"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center"
                                                           FontSize="12"
                                                           Foreground="#2A3340"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="当前没有工作区变更"
                                           Foreground="#98A2B0"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasWorkspaceChanges}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <DockPanel Grid.Row="2" Margin="0,13,0,8">
                            <TextBlock Text="Diff"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#667386" />
                            <StackPanel DockPanel.Dock="Right"
                                        Orientation="Horizontal">
                                <Button Command="{Binding CommitAllWorkspaceChangesCommand}"
                                        Content="提交全部"
                                        Width="76"
                                        Height="28"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource SubtleButtonStyle}" />
                                <TextBlock Text="{Binding WorkspaceBranch}"
                                           FontSize="11"
                                           Foreground="#98A2B0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="110" />
                            </StackPanel>
                        </DockPanel>

                        <Border Grid.Row="3"
                                Padding="10"
                                CornerRadius="8"
                                Background="#FBFCFD"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1">
                            <ScrollViewer Style="{StaticResource ModernScrollViewerStyle}"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding WorkspaceDiffText}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Foreground="#2A3340"
                                           TextWrapping="NoWrap" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
            <!-- Call-detail overlay for inspecting the exact provider request/response. -->
            <Grid Grid.RowSpan="2" Background="#B8EEF1F4">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCallDetailsOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Border Width="940"
                        Height="640"
                        MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                        MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                        Margin="24"
                        Padding="22"
                        Background="#FFFFFF"
                        CornerRadius="10"
                        BorderBrush="#DCE3EC"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="{Binding CallDetailsTitle}" FontSize="20" FontWeight="SemiBold" Foreground="#1E252E" />
                                <TextBlock Text="查看每次模型调用的入参 JSON 和出参 JSON。"
                                           Margin="0,6,0,0"
                                           Foreground="#748092" />
                            </StackPanel>
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding CloseCallDetailsCommand}"
                                    Content="×"
                                    Style="{StaticResource IconButtonStyle}"
                                    HorizontalAlignment="Right" />
                        </DockPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" BorderBrush="#E2E7EE" BorderThickness="1" CornerRadius="8" Background="#F8FAFC">
                                <Grid>
                                    <ListBox ItemsSource="{Binding CurrentCallDetails}"
                                             SelectedItem="{Binding SelectedCallDetail, Mode=TwoWay}"
                                             ItemTemplate="{StaticResource CallDetailListTemplate}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Padding="6"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                    <TextBlock Text="暂无调用记录"
                                               Foreground="#98A2B0"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentCallDetails.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="16" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" BorderBrush="#E2E7EE" BorderThickness="1" CornerRadius="8" Background="#FFFFFF">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="调用入参 JSON" Margin="14,12,14,8" FontWeight="SemiBold" Foreground="#303A47" />
                                        <TextBox Grid.Row="1"
                                                 Text="{Binding SelectedCallRequestJson, Mode=OneWay}"
                                                 Margin="12,0,12,12"
                                                 Style="{StaticResource JsonTextBoxStyle}" />
                                    </Grid>
                                </Border>

                                <Border Grid.Row="2" BorderBrush="#E2E7EE" BorderThickness="1" CornerRadius="8" Background="#FFFFFF">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <DockPanel Margin="14,12,14,8">
                                            <TextBlock Text="调用出参 JSON" FontWeight="SemiBold" Foreground="#303A47" VerticalAlignment="Center" />
                                            <CheckBox DockPanel.Dock="Right"
                                                      Content="展开原始事件"
                                                      IsChecked="{Binding ShowSelectedCallRawEvents, Mode=TwoWay}"
                                                      Foreground="#596473"
                                                      FontSize="12"
                                                      HorizontalAlignment="Right" />
                                        </DockPanel>
                                        <TextBox Grid.Row="1"
                                                 Text="{Binding SelectedCallResponseJson, Mode=OneWay}"
                                                 Margin="12,0,12,12"
                                                 Style="{StaticResource JsonTextBoxStyle}" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
            <!-- Settings overlay for provider keys, model choice, and generation knobs. -->
            <Grid Grid.RowSpan="2" Background="#B8EEF1F4">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Border Width="780"
                        Height="560"
                        MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                        Margin="24"
                        Padding="24"
                        Background="#FFFFFF"
                        CornerRadius="10"
                        BorderBrush="#DCE3EC"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel>
                            <StackPanel>
                                <TextBlock Text="项目设置" FontSize="22" FontWeight="SemiBold" Foreground="#1E252E" />
                                <TextBlock Text="管理当前客户端可用的模型服务。"
                                           Margin="0,6,0,0"
                                           Foreground="#748092" />
                            </StackPanel>
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding CloseSettingsCommand}"
                                    Content="×"
                                    Style="{StaticResource IconButtonStyle}"
                                    HorizontalAlignment="Right" />
                        </DockPanel>

                        <TabControl Grid.Row="1"
                                    Margin="0,20,0,22"
                                    VerticalAlignment="Stretch">
                            <TabItem Header="模型">
                                <ScrollViewer Style="{StaticResource ModernScrollViewerStyle}"
                                              VerticalAlignment="Stretch"
                                              VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,8">
                                    <TextBlock Text="模型提供商" Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox ItemsSource="{Binding ProviderOptions}"
                                              SelectedValue="{Binding SelectedProviderId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Id"
                                              ItemTemplate="{StaticResource ProviderOptionTemplate}"
                                              Padding="12,0" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,8">
                                    <TextBlock Text="API Key" Style="{StaticResource FieldLabelStyle}" />
                                    <Grid>
                                        <TextBox Text="{Binding NewProviderApiKey, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource SettingsTextBoxStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNewProviderApiKeyVisible}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <PasswordBox x:Name="NewProviderPasswordBox"
                                                     PasswordChanged="NewProviderPasswordBox_PasswordChanged">
                                            <PasswordBox.Style>
                                                <Style TargetType="PasswordBox" BasedOn="{StaticResource SettingsPasswordBoxStyle}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNewProviderApiKeyVisible}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </PasswordBox.Style>
                                        </PasswordBox>
                                    </Grid>
                                    <DockPanel Margin="0,12,0,0">
                                        <Button Command="{Binding ToggleNewProviderApiKeyVisibilityCommand}"
                                                Content="显示/隐藏"
                                                Width="92"
                                                Height="40"
                                                Style="{StaticResource SubtleButtonStyle}" />
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Command="{Binding TestProviderConnectionCommand}"
                                                    Content="测试连接"
                                                    Width="92"
                                                    Height="40"
                                                    Margin="0,0,10,0"
                                                    Style="{StaticResource SubtleButtonStyle}" />
                                            <Button Command="{Binding AddConfiguredProviderCommand}"
                                                    Content="添加到已配置列表"
                                                    Width="160"
                                                    Height="40"
                                                    Style="{StaticResource PrimaryButtonStyle}" />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,8">
                                    <TextBlock Text="已配置" Style="{StaticResource FieldLabelStyle}" />
                                    <DockPanel>
                                        <ComboBox ItemsSource="{Binding ConfiguredProviders}"
                                                  SelectedValue="{Binding SelectedConfiguredProviderId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="Id"
                                                  ItemTemplate="{StaticResource ConfiguredProviderTemplate}"
                                                  Padding="12,0"
                                                  DockPanel.Dock="Left"
                                                  Width="564" />
                                        <Button Command="{Binding RemoveConfiguredProviderCommand}"
                                                Content="移除"
                                                Width="86"
                                                Height="38"
                                                Margin="12,0,0,0"
                                                Style="{StaticResource SubtleButtonStyle}" />
                                    </DockPanel>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.Column="0">
                                    <TextBlock Text="当前模型" Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox ItemsSource="{Binding ActiveModelOptions}"
                                              SelectedValue="{Binding SelectedActiveModelId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Id"
                                              ItemTemplate="{StaticResource ModelOptionTemplate}"
                                              Padding="12,0" />
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.Column="2">
                                    <TextBlock Text="模型上下文" Style="{StaticResource FieldLabelStyle}" />
                                    <Border Height="38" Padding="12,0" CornerRadius="10" Background="#F4F6F8" BorderBrush="#DDE2EA" BorderThickness="1">
                                        <TextBlock Text="{Binding Settings.ModelContextLimit, StringFormat={}{0:N0} tokens}"
                                                   Foreground="#303A47"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
                                    <TextBlock Text="当前模型能力" Style="{StaticResource FieldLabelStyle}" />
                                    <Border Padding="12,10" CornerRadius="8" Background="#F5F8FA" BorderBrush="#E1E8EF" BorderThickness="1">
                                        <TextBlock Text="{Binding ActiveModelCapabilitySummary}"
                                                   Foreground="#596473"
                                                   TextWrapping="Wrap" />
                                    </Border>

                                    <StackPanel Margin="0,4,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasModelParameterOptions}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="执行模型参数" Style="{StaticResource FieldLabelStyle}" />
                                        <ItemsControl ItemsSource="{Binding ModelParameterOptions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="210" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#1E252E" />
                                                            <TextBlock Text="{Binding Description}" Margin="0,4,12,0" Foreground="#748092" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <ComboBox Grid.Column="1"
                                                                  ItemsSource="{Binding Options}"
                                                                  SelectedValue="{Binding SelectedValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  SelectedValuePath="Value"
                                                                  DisplayMemberPath="DisplayName"
                                                                  Padding="12,0" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="工具">
                                <ScrollViewer Style="{StaticResource ModernScrollViewerStyle}"
                                              VerticalAlignment="Stretch"
                                              VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <Border Padding="14"
                                                CornerRadius="8"
                                                Background="#F5F8FA"
                                                BorderBrush="#E1E8EF"
                                                BorderThickness="1"
                                                Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="可发送给模型选择的工具"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="#1E252E" />
                                                <TextBlock Text="只勾选你希望模型在后续请求中可调用的工具。写入、修改和 Shell 工具会影响当前项目，请按测试场景谨慎开启。"
                                                           Margin="0,6,0,0"
                                                           Foreground="#667386"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding ToolOptions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,10"
                                                            Padding="16,14"
                                                            CornerRadius="8"
                                                            Background="#FFFFFF"
                                                            BorderBrush="#E2E8F0"
                                                            BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="148" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      VerticalAlignment="Center"
                                                                      Margin="0,0,14,0" />
                                                            <StackPanel Grid.Column="1">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Name}"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="#1E252E" />
                                                                    <Border Margin="8,0,0,0" Padding="6,2" CornerRadius="6" Background="#EEF5F3" BorderBrush="#D9E9E5" BorderThickness="1">
                                                                        <TextBlock Text="{Binding RiskLabel}" FontSize="11" Foreground="#3E6F68" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Description}"
                                                                           Margin="0,4,0,0"
                                                                           Foreground="#667386"
                                                                           TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <ComboBox Grid.Column="2"
                                                                      ItemsSource="{Binding PermissionModeOptions}"
                                                                      SelectedValue="{Binding PermissionMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      SelectedValuePath="Id"
                                                                      ItemTemplate="{StaticResource SelectionOptionTemplate}"
                                                                      Padding="10,0"
                                                                      VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>

                        <DockPanel Grid.Row="2">
                            <TextBlock Text="添加后可在对话输入框右下角直接切换模型。"
                                       Foreground="#8B96A6"
                                       VerticalAlignment="Center" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Command="{Binding CloseSettingsCommand}" Content="取消" Width="88" Height="38" Margin="0,0,10,0" Style="{StaticResource SubtleButtonStyle}" />
                                <Button Command="{Binding SaveSettingsCommand}" Content="保存" Width="96" Height="38" Style="{StaticResource PrimaryButtonStyle}" />
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
